{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/content/**",
              "components/controls/**",
              "components/core/**",
              "components/feedback/**",
              "theme/**",
              "ui_kits/studio/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Plus Jakarta Sans|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Plus Jakarta Sans, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentPicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:accent|onChange|key|ref|className|style|children)$/]",
        "message": "<AccentPicker> doesn't accept that prop. Declared props: accent, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|icon|iconRight|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, icon, iconRight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|danger|icon)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'danger' | 'icon'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompactSelectorItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|key|ref|className|style|children)$/]",
        "message": "<CompactSelectorItem> doesn't accept that prop. Declared props: id, name."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconGlyph'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|className|style|key|ref|className|style|children)$/]",
        "message": "<IconGlyph> doesn't accept that prop. Declared props: size, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|title|className|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: size, title, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Markdown'] > JSXAttribute > JSXIdentifier[name!=/^(?:content|key|ref|className|style|children)$/]",
        "message": "<Markdown> doesn't accept that prop. Declared props: content."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onClose|className|labelledBy|label|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: children, onClose, className, labelledBy, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:ok|key|ref|className|style|children)$/]",
        "message": "<StatusDot> doesn't accept that prop. Declared props: ok."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "AccentPicker": {
        "replaces": []
      },
      "Button": {
        "replaces": []
      },
      "CompactSelectorItem": {
