{
  // Courier / workshop / red parcel on LTX-2.5 (epic 22708, sc-22715) — the SAME six shots, roles,
  // dependencies and sound as `plan.jsonc`, with only the model block changed. It exists so the
  // first LTX-2.5 plan `film-harness` sees is not the first exercise of that model's menus:
  // `the_ltx_2_5_plan_validates_against_the_live_catalog_and_off_menu_values_are_refused_by_name`
  // validates it against the shipped catalog entry and refuses an off-menu fps or duration by
  // name. Select it with `--plan config/film-harness/courier-workshop/plan.ltx25.jsonc`
  // (`PLAN=… scripts/film-harness-smoke.sh` for the smoke); the reference pack is the shared
  // `references.jsonc`.
  //
  // Every value below is on the `ltx_2_5` entry's declared menus
  // (config/manifests/builtin.models.jsonc): durations [4, 6, 8, 10, 12, 15] s, fps [24, 25, 30],
  // resolutions [768x512, 512x768, 640x640, 1280x704, 704x1280], `mlx.minMemoryGb` 31. The tier
  // is `q4`, the entry's `default: true` download row (`distilled/q4/*` + `dev/q4/*`), which is
  // the tier the installed `SceneWorks/ltx-2.5-mlx` rehost at revision 081658ce provides on the
  // dev Mac beside q8 and bf16 — read off the catalog entry and the snapshot on disk, not guessed.
  // The entry declares `supportsNegativePrompt: false`, so no shot carries a negative prompt, and
  // no `maxReferenceAssets`, so no shot lists referenceRoles; keyframe modes take a first (and
  // last) frame exactly as they do on H3.
  //
  // Dialogue offsets are measured from the start of their shot and sit well inside the 6 s clips.
  "schemaVersion": 3,
  "id": "courier-workshop-ltx25",
  "version": 1,
  "title": "Courier at the Workshop (LTX-2.5)",
  "synopsis": "A courier enters a cluttered workshop carrying a red parcel, sets it on the workbench and leaves; the recipient comes in, finds the parcel and opens it.",
  "model": {
    "id": "ltx_2_5",
    "tier": "q4",
    "fps": 25,
    "resolution": "768x512"
  },
  "limits": {
    "maxRunSeconds": 7200,
    "maxShotSeconds": 2700,
    "maxAttemptsPerShot": 1,
    "maxMemoryGb": 96
  },
  "sound": {
    "generatedAudio": "mute",
    "dialogue": { "gain": 1.0, "muted": false },
    "ambience": {
      "role": "workshop_room_tone",
      "gain": 0.35,
      "fadeInSeconds": 1.0,
      "fadeOutSeconds": 1.5
    },
    "music": {
      "role": "main_theme",
      "gain": 0.2,
      "startSeconds": 0.0,
      "fadeInSeconds": 2.0,
      "fadeOutSeconds": 3.0
    }
  },
  "shots": [
    {
      "id": "SH010",
      "beat": "Establish the empty workshop; the door opens.",
      "framing": "wide static, eye level, door camera-left, workbench centre",
      "prompt": "A quiet, cluttered woodworking workshop in warm late-afternoon light. Tools hang on pegboard, sawdust on a long wooden workbench in the centre of frame, a closed door on the left. After a beat the door opens and a courier in a blue jacket steps into the doorway holding a small bright red parcel. Static wide shot, natural light, film grain.",
      "targetDurationSeconds": 6,
      "startState": "Empty workshop, door closed, workbench clear.",
      "endState": "Door open, courier standing in the doorway holding the red parcel, workbench still clear.",
      "audio": "Room tone, distant birds, a door latch clicking and the door creaking open. No music.",
      "conditioning": { "mode": "text_to_video" },
      "seed": 22710,
      "continuityRoles": ["workshop_location", "workbench_table", "courier", "red_parcel", "house_style"]
    },
    {
      "id": "SH020",
      "beat": "The courier crosses to the workbench with the parcel.",
      "framing": "medium, slow push-in following the courier to the bench",
      "prompt": "Starting from this view of the workshop, a courier in a blue jacket walks in from the left carrying a small bright red parcel with both hands and approaches the wooden workbench in the centre. Warm late-afternoon light, sawdust in the air, natural handheld feel, film grain.",
      "targetDurationSeconds": 6,
      "startState": "Courier in the doorway with the red parcel.",
      "endState": "Courier standing at the workbench, parcel still in hand.",
      "dialogue": "Courier: \"Delivery — I'll leave it on the bench.\"",
      "dialogueClip": { "role": "courier_line", "offsetSeconds": 1.2, "gain": 1.0 },
      "audio": "Footsteps on a wooden floor, cardboard creak of the parcel, room tone. No music.",
      "conditioning": { "mode": "image_to_video", "firstFrameRole": "workshop_plate" },
      "seed": 22711,
      "dependsOn": [{ "shotId": "SH010", "kind": "continuity", "note": "The courier and the parcel enter in SH010; SH020 starts from that doorway." }],
      "continuityRoles": ["workshop_location", "workbench_table", "courier", "red_parcel", "house_style"]
    },
    {
      "id": "SH030",
      "beat": "The courier places the red parcel on the workbench.",
      "framing": "close on the workbench surface, hands and parcel",
      "prompt": "Close-up on a wooden workbench dusted with sawdust. Two hands in the sleeves of a blue courier jacket lower a small bright red parcel onto the bench and let go, then withdraw out of frame. Warm late-afternoon light, shallow depth of field, film grain.",
      "targetDurationSeconds": 6,
      "startState": "Parcel in the courier's hands above the bench.",
      "endState": "Red parcel resting on the workbench, hands gone.",
      "audio": "Soft thump of cardboard on wood, sleeves rustling, room tone. No music.",
      "conditioning": { "mode": "text_to_video" },
      "seed": 22712,
      "dependsOn": [{ "shotId": "SH020", "kind": "continuity", "note": "SH030 starts with the parcel in the hands SH020 brought to the bench." }],
      "continuityRoles": ["workbench_table", "courier", "red_parcel", "house_style"]
    },
    {
      "id": "SH040",
      "beat": "The courier leaves; the parcel stays.",
      "framing": "wide static, same setup as SH010",
      "prompt": "Starting from this view of the workshop with a small bright red parcel resting on the wooden workbench, a courier in a blue jacket walks away from the bench toward the door on the left, steps out and pulls the door closed behind them. The parcel stays on the bench. Static wide shot, warm late-afternoon light, film grain.",
      "targetDurationSeconds": 6,
      "startState": "Courier at the bench, red parcel on the bench.",
      "endState": "Door closed, workshop empty except for the red parcel on the bench.",
      "audio": "Footsteps receding, door creak and latch, then room tone. No music.",
      "conditioning": { "mode": "image_to_video", "firstFrameRole": "workshop_plate" },
      "seed": 22713,
      "dependsOn": [{ "shotId": "SH030", "kind": "continuity", "note": "SH040 starts from the parcel SH030 left resting on the workbench." }],
      "continuityRoles": ["workshop_location", "workbench_table", "courier", "red_parcel", "house_style"]
    },
    {
      "id": "SH050",
      "beat": "The recipient enters and notices the parcel.",
      "framing": "medium, recipient enters camera-left, bench centre",
      "prompt": "A man in a grey work apron with rolled sleeves enters a cluttered woodworking workshop through the door on the left, wiping his hands on a rag. He stops as he notices a small bright red parcel sitting on the wooden workbench in the centre and walks toward it. Warm late-afternoon light, film grain.",
      "targetDurationSeconds": 6,
      "startState": "Empty workshop, red parcel on the bench, door closed.",
      "endState": "Recipient standing at the bench looking down at the parcel.",
      "dialogue": "Recipient (quietly): \"Huh. That's not mine.\"",
      "dialogueClip": { "role": "recipient_line", "offsetSeconds": 2.6, "gain": 1.0 },
      "audio": "Door opening, footsteps, a rag dropped on the bench, room tone. No music.",
      "conditioning": { "mode": "text_to_video" },
      "seed": 22714,
      "dependsOn": [{ "shotId": "SH040", "kind": "continuity", "note": "SH050 starts from the empty workshop SH040 closed the door on." }],
      "continuityRoles": ["workshop_location", "workbench_table", "recipient", "red_parcel", "house_style"]
    },
    {
      "id": "SH060",
      "beat": "The recipient opens the parcel.",
      "framing": "close on hands and parcel, slight high angle",
      "prompt": "Close-up on a small bright red parcel on a sawdust-covered wooden workbench. A man's hands with a grey apron sleeve tear the tape, fold back the flaps and lift the lid, and a soft warm glow from inside lights his fingers. Shallow depth of field, warm late-afternoon light, film grain.",
      "targetDurationSeconds": 6,
      "startState": "Sealed red parcel on the bench, recipient's hands entering frame.",
      "endState": "Parcel open, flaps folded back, hands resting on the bench beside it.",
      "dialogue": "Recipient (whisper): \"Oh. Oh, that's lovely.\"",
      "dialogueClip": { "role": "recipient_reveal_line", "offsetSeconds": 3.0, "gain": 0.8, "fadeOutSeconds": 0.4 },
      "audio": "Tape tearing, cardboard flaps, a soft musical swell as the lid lifts.",
      "conditioning": { "mode": "text_to_video" },
      "seed": 22715,
      "dependsOn": [{ "shotId": "SH050", "kind": "continuity", "note": "SH060 opens the parcel SH050 found sealed on the bench." }],
      "continuityRoles": ["workbench_table", "recipient", "red_parcel", "house_style"]
    }
  ]
