          "ask": "At this moment, is the parcel resting on the workbench on its own, or is someone still holding it? Answer with one of those, or say you cannot tell.",
          "expect": ["resting on", "on the workbench", "on the bench", "on its own", "nobody is holding", "no one is holding"],
          "contradict": ["still holding", "still being held", "in the hands", "someone is holding", "being carried"]
        },
        {
          "id": "sh030_action", "topic": "action_completion", "frames": "last", "mustObserve": true,
          "intended": "The hands let go of the parcel and withdraw from frame.",
          "ask": "At this moment, have the hands let go of the parcel and left the frame? Answer yes or no, or say you cannot tell.",
          "expect": ["let go", "hands are gone", "hands have left", "no hands", "withdrawn", "released"],
          "contradict": ["still holding", "hands are still", "have not let go", "still gripping", "still in frame holding"]
        },
        {
          "id": "sh030_cut", "topic": "cut_continuity", "frames": "first", "acrossCut": true,
          "intended": "SH030 starts with the parcel in the hands SH020 brought to the bench.",
          "ask": "Describe this frame in one sentence: what surface is shown, what object is on or above it, and what colour that object is.",
          "expect": ["red"],
          "contradict": ["blue box", "blue parcel", "brown parcel", "green box", "no parcel", "no box", "empty bench"]
        }
      ]
    },

    "SH040": {
      "questions": [
        {
          "id": "sh040_location", "topic": "location", "frames": "all",
          "intended": "The same workshop, wide, matching SH010's setup.",
          "ask": "Is the room in this frame a cluttered woodworking workshop with a long wooden workbench? Answer with yes or no, then name the room you actually see.",
          "expect": ["workshop", "woodworking", "workbench"],
