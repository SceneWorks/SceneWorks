          "expect": ["door is closed", "closed door", "door closed"],
          "contradict": ["door is open", "open door", "door remains open", "still standing", "a person is still"]
        },
        {
          "id": "sh040_cut", "topic": "cut_continuity", "frames": "first", "acrossCut": true,
          "intended": "SH040 starts from the parcel SH030 left resting on the workbench.",
          "ask": "Describe this frame in one sentence: the kind of room, and what is resting on the workbench.",
          "expect": ["red"],
          "contradict": ["blue box", "blue parcel", "brown parcel", "no parcel", "no box", "empty bench", "nothing on the"]
        }
      ]
    },

