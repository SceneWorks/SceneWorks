          "id": "sh020_courier", "topic": "character_identity", "frames": "all",
          "intended": "The courier is in frame throughout the shot.",
          "ask": "Is a person visible anywhere in this frame? Answer yes or no, then describe who you see.",
          "expect": ["courier", "a person", "one person", "man", "woman"],
          "contradict": ["no person", "no people", "nobody", "no one", "empty room", "there is no"]
        },
        {
          "id": "sh020_courier_jacket", "topic": "costume", "frames": "all",
          "intended": "The courier still wears the blue jacket.",
          "ask": "What colour is the jacket of the person in this frame? Answer with the colour, or say you cannot tell.",
          "expect": ["blue"],
          "contradict": ["red jacket", "green jacket", "yellow jacket", "grey jacket", "gray jacket", "black jacket", "no jacket", "apron"]
        },
        {
          "id": "sh020_parcel", "topic": "parcel_identity", "frames": "all",
          "intended": "The same small bright red parcel.",
          "ask": "Is there a small parcel or box in this frame? If so, what colour is it?",
          "expect": ["red"],
          "contradict": ["blue box", "blue parcel", "brown box", "brown parcel", "green box", "white box", "no parcel", "no box"]
        },
        {
          "id": "sh020_parcel_custody", "topic": "parcel_custody", "frames": "last", "mustObserve": true,
          "intended": "The parcel is still in the courier's hands at the workbench.",
          "ask": "Is the parcel still in the person's hands at this moment, or has it been set down? Answer with one of those, or say you cannot tell.",
          "expect": ["still in", "in their hands", "in the hands", "still holding", "holding"],
          "contradict": ["set down", "put down", "on the bench", "on the workbench", "let go", "released", "no longer holding"]
        },
        {
          "id": "sh020_action", "topic": "action_completion", "frames": "last", "mustObserve": true,
          "intended": "By the end of the shot the courier has reached the workbench.",
          "ask": "At this moment, has the person reached the workbench, or are they still away from it? Answer with one of those, or say you cannot tell.",
          "expect": ["at the workbench", "reached the workbench", "reached the bench", "at the bench", "beside the bench", "standing at"],
          "contradict": ["still in the doorway", "has not reached", "not reached", "still by the door", "away from the bench", "not at the bench"]
        },
        {
          "id": "sh020_cut", "topic": "cut_continuity", "frames": "first", "acrossCut": true,
          "intended": "SH020 starts from the doorway SH010 ended on: same room, same person, same jacket.",
          "ask": "Describe the room and the person in this frame in one sentence: the kind of room, and the colour of the person's clothing.",
          "expect": ["workshop", "woodworking", "workbench"],
          "contradict": ["kitchen", "bedroom", "office", "outdoors", "street", "no person", "nobody"]
        }
      ]
    },

    "SH030": {
      "questions": [
        {
          "id": "sh030_bench", "topic": "location", "frames": "all",
          "intended": "Close on the sawdust-covered wooden workbench.",
          "ask": "Is the surface in this frame a wooden workbench? Answer with yes or no, then name the surface you actually see.",
          "expect": ["workbench", "wooden bench", "wooden work", "wood bench"],
