{
  // Review questions for the courier/workshop/red-parcel fixture (epic 22708, sc-22714).
  // Schema: crates/sceneworks-core/src/film_review.rs (`ReviewPlan`).
  //
  // This is a THIRD document beside plan.jsonc and references.jsonc, deliberately: the intended
  // state lives in the plan (`shots[].startState` / `endState`), and how to INTERROGATE a take is
  // review configuration with its own version. Nothing here is sent to a generation model — these
  // questions only ever reach the `image_vqa` understanding job, and what comes back is written to
  // an observed-state document that no later shot reads.
  //
  // Each question declares:
  //   topic        one of the seven continuity dimensions the benchmark tests
  //   intended     the plan's claim, restated for the human who reads the flag
  //   ask          the question put to the vision model, verbatim (reproducible from this file)
  //   expect       answer substrings meaning the take agrees with the intent
  //   contradict   answer substrings meaning it contradicts the intent (checked FIRST — the
  //                negative phrasing is the specific one)
  //   frames       which sampled frames to grade on: first / last / all / any
  //   mustObserve  an UNOBSERVED answer is itself an actionable flag. Set on every handoff and
  //                action-completion question: a thing nobody saw is never recorded as completed.
  //   acrossCut    also ask the last frame of the selected take this shot declares a dependsOn on
  //
  // An answer that carries an "I cannot tell" marker, or matches neither list, is UNOBSERVED and
  // carries no value at all. Silence is not agreement.
  "schemaVersion": 1,
  "id": "courier-workshop-review",
  "version": 1,
  "description": "Character, costume, location, parcel identity/custody, action completion and cut continuity for the courier/workshop sequence.",

  // Three frames per take: the opening state, the middle, and the end state the plan's `endState`
  // describes. Strictly increasing fractions of the take's own duration.
  "sampling": { "positions": [0.08, 0.5, 0.94] },

  // Declared BEFORE anything is dispatched. A review that reaches one of these stops, records why,
  // and keeps the partial evidence. 3 frames x up to 8 questions x 180s bounds one shot's review
  // well inside maxSeconds.
  "limits": {
    "maxSeconds": 1200,
    "maxFramesPerShot": 3,
    "maxQuestionsPerShot": 8,
    "maxAnswerSeconds": 180
  },

  // A contradiction the model hedged ("it appears blue") is reported `uncertain` rather than
  // `mismatch`, so the doubt survives into the record instead of being rounded up to a fact.
  "uncertainBelow": 0.5,

  "shots": {
    "SH010": {
      "questions": [
        {
          "id": "sh010_location", "topic": "location", "frames": "all",
          "intended": "A cluttered woodworking workshop with a long wooden workbench.",
          "ask": "Is the room in this frame a cluttered woodworking workshop with a long wooden workbench? Answer with yes or no, then name the room you actually see.",
          "expect": ["workshop", "woodworking", "workbench"],
          "contradict": ["kitchen", "bedroom", "office", "bathroom", "outdoors", "street", "not a workshop", "not a woodworking"]
        },
        {
          "id": "sh010_courier", "topic": "character_identity", "frames": "last",
          "intended": "A courier is standing in the doorway.",
          "ask": "Is a person standing in or near the doorway of this room? Answer yes or no, then describe who you see.",
          "expect": ["courier", "a person", "one person", "delivery", "man", "woman"],
          "contradict": ["no person", "no people", "nobody", "no one", "empty room", "there is no"]
        },
        {
          "id": "sh010_courier_jacket", "topic": "costume", "frames": "last",
          "intended": "The courier wears a blue jacket.",
          "ask": "What colour is the jacket of the person in the doorway? Answer with the colour, or say you cannot tell.",
          "expect": ["blue"],
          "contradict": ["red jacket", "green jacket", "yellow jacket", "grey jacket", "gray jacket", "black jacket", "no jacket", "apron"]
        },
        {
          "id": "sh010_parcel", "topic": "parcel_identity", "frames": "last",
          "intended": "The courier is holding a small bright red parcel.",
          "ask": "Is there a small parcel or box in this frame? If so, what colour is it?",
          "expect": ["red"],
          "contradict": ["blue box", "blue parcel", "brown box", "brown parcel", "green box", "white box", "no parcel", "no box"]
        },
        {
          "id": "sh010_parcel_custody", "topic": "parcel_custody", "frames": "last", "mustObserve": true,
          "intended": "The parcel is in the courier's hands, not on the workbench.",
          "ask": "Who or what has the parcel in this frame — is it in a person's hands, or is it resting on a surface? Answer with one of those, or say you cannot tell.",
          "expect": ["in a person", "in their hands", "in the hands", "holding", "carried"],
          "contradict": ["on the workbench", "on the bench", "on a table", "on the floor", "on the ground", "resting on"]
        },
        {
          "id": "sh010_action", "topic": "action_completion", "frames": "last", "mustObserve": true,
          "intended": "By the end of the shot the door is open and the workbench is still clear.",
          "ask": "At this moment, is the door open, and is the workbench clear of any parcel? Answer with both: door open or closed, workbench clear or not.",
          "expect": ["door is open", "open door", "door open"],
          "contradict": ["door is closed", "closed door", "door remains closed", "parcel on the workbench", "parcel on the bench"]
        }
      ]
    },

    "SH020": {
      "questions": [
        {
          "id": "sh020_location", "topic": "location", "frames": "all",
          "intended": "The same cluttered woodworking workshop as SH010.",
          "ask": "Is the room in this frame a cluttered woodworking workshop with a long wooden workbench? Answer with yes or no, then name the room you actually see.",
