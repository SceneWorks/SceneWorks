      "id": "supra2_img",
      "name": "Supra2-IMG",
      "family": "supra2",
      "type": "image",
      "adapter": "mlx_supra2",
      // Served on both lanes under the same engine id (sc-24213 MLX / sc-24214 Candle), so the entry
