          "provider": "huggingface",
          "repo": "SceneWorks/Mage-Flow-Components-mlx",
          "revision": "c936de2a107ee8d0869137e73943f6414f23adaa",
          "coRequisite": true,
          "componentId": "vae",
          "variant": "q8",
          "subdir": "q8/vae",
          "files": ["q8/vae/*"],
          "estimatedSizeBytes": 345053168
        },
        {
          "provider": "huggingface",
          "repo": "SceneWorks/Mage-Flow-Components-mlx",
          "revision": "c936de2a107ee8d0869137e73943f6414f23adaa",
          "coRequisite": true,
          "componentId": "vae",
