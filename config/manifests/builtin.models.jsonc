      "limits": {
        "durations": [4, 6, 8, 10, 12, 15],
        "recommendedMaxDuration": 10,
        "hardMaxDuration": 15,
        "fps": [24, 25, 30],
        // LTX is bucket-trained on 480p/720p derivatives; squares above 640x640
        // fall outside the training distribution and produce black frames. Keep
        // the square option at 640x640 even though normalized_dimensions would
        // accept larger.
        //
        // The engine requires W×H divisible by **64**, not 32: `validate_request`
        // hard-errors otherwise (mlx-gen-ltx/src/model.rs:1047) because stage-1 runs
        // at `//2//32`. The previously declared 32 was too loose — it let a request
        // floor onto a ÷32-but-not-÷64 size (e.g. 736) that the engine then rejects.
        // `720` is not on the ÷64 lattice, so the 720p buckets are advertised at their
        // real geometry (704 = 64·11), the way scail2_14b already does (sc-12294).
        "resolutions": ["768x512", "512x768", "640x640", "1280x704", "704x1280"],
        "requiresDimensionsMultipleOf": 64,
        // Epic 7114 curated sampler menu (sc-7296): both backends' LTX engine advertises the full
        // curated set (candle also keeps the legacy `rectified-flow` alias). No scheduler axis.
        "samplers": ["default", "euler", "euler_ancestral", "heun", "dpmpp_2m", "dpmpp_sde", "uni_pc", "lcm", "ddim"]
      },
      "loraCompatibility": {
        "families": ["ltx-video"],
        "types": ["style", "motion", "character", "enhance"]
      },
      "mlx": {
        // Turnkey pre-converted MLX bundle on the SceneWorks HF org (sc-5608, epic 5594) —
        // replaces the third-party notapalindrome (LTX) + mlx-community (gemma) mirrors. One repo
        // with `q4/` (default) + `q8/` (opt-in via advanced mlxQuantize: 8) LTX subdirs and the
        // bundled `gemma/` text encoder. The worker (resolve_ltx_model_dir, video_jobs.rs) picks the
        // quant subdir and points the engine at the bundled gemma via $LTX_GEMMA_DIR, so a fresh
        // install needs no separate gemma snapshot. Downloaded on first use (the macOS entry in
        // downloads above); no in-app conversion. Dual-licensed (LTX-2 Community License + Google
        // Gemma Terms — distributed under those, not Apache). minMemoryGb mirrors MlxVideoAdapter
        // estimate_requirements peak_gb (the weights are pre-quantized, so no bf16 load transient).
        "minMemoryGb": 31,
        "repo": "SceneWorks/ltx-2.3-mlx"
      },
      "ui": {
        "label": "LTX-2.3",
        "description": "First-class short-shot video target for image-to-video and text-to-video.",
