          "provider": "huggingface",
          "repo": "SceneWorks/ltx-2.3-mlx",
          "coRequisite": true,
          "revision": "254989c3ca7ee691187647f350b112c0c448789d",
          "files": ["gemma/*"],
          "platforms": ["macos", "windows", "linux"],
          "estimatedSizeBytes": 26427894918
        },
        {
          "provider": "huggingface",
          "repo": "TenStrip/LTX2.3-10Eros",
          "revision": "84a05a13610d78dbe4340d1be23fd8185e10f697",
          // Community LTX-2.3 merge (Sulphur-2-base, I2V-tuned). The repo also ships
          // fp8 and fp8-transformer variants; we only need the bf16 all-in-one, which
          // shares the official ltx-2.3-22b-distilled key layout (model.diffusion_model.*
          // transformer + bundled vae/audio_vae/vocoder), so it is a drop-in checkpoint.
          "files": ["10Eros_v1.3_bf16.safetensors"],
          "default": true,
          "platforms": ["macos"],
          "estimatedSizeBytes": 46139885750
        },
        {
          // Recommended cond_safe distill LoRA. Required runtime component on the MLX path: it is
          // auto-injected per-pass (see mlx.autoDistillLora) so 10Eros produces usable text-to-video.
          // Only the cond_safe variant is fetched.
          "provider": "huggingface",
          "repo": "TenStrip/LTX2.3_Distilled_Lora_1.1_Experiments",
          "revision": "9c3548954510182827d7bfc872fd7cceb64230fd",
          // Co-requisite (sc-9696): the cond_safe distill LoRA is a required runtime component
          // (auto-injected per-pass; see mlx.autoDistillLora), so it must download alongside the
          // 10Eros checkpoint rather than being a pick-one alternate.
          "coRequisite": true,
          // This adapter is exclusive to Eros. If an old off-Mac Eros install is removed through
          // its cleanup-only catalog tombstone, reclaim this repo alongside the primary checkpoint.
          "cleanupWithModel": true,
          "files": ["ltx-2.3-22b-distilled-lora-1.1_fro90_ceil72_condsafe.safetensors"],
          "platforms": ["macos"],
          "estimatedSizeBytes": 662072824
        }
