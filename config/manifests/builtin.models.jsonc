          "coRequisite": true,
          "componentId": "fl2va_audio_vae_config",
          "subdir": "FL2VA/audio_vae",
          // sc-19558 CORRECTION — same three documents, same reason. They matter MORE on this
          // partition: ref2va is the only route that constructs `MiniMaxH3AudioVaeEncoder`, and
          // `load_audio_encoder` parses this same triple for its geometry.
          "files": [
            "FL2VA/audio_vae/config.json",
            "FL2VA/audio_vae/config.yaml",
            "FL2VA/audio_vae/metadata.json"
          ],
