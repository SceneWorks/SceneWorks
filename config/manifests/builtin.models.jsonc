          "default": true,
          "files": ["q4/*"],
          "estimatedSizeBytes": 15121207547,
          "footprint": { "diskSizeBytes": 15121207547, "residentMemoryBytes": null, "peakMemoryBytes": null }
        },
        {
          "provider": "huggingface",
          "repo": "SceneWorks/chroma1-base-mlx",
          "revision": "e7330dda29d00ffdeeb719b28e92ee74cff0884c",
