      "defaults": {
        "duration": 5,
        "fps": 16,
        "resolution": "1280x720",
        "quality": "balanced",
        "sampler": "default",
        "scheduler": "default"
      },
      "limits": {
        "durations": [3, 4, 5],
        "recommendedMaxDuration": 5,
        "hardMaxDuration": 5,
        "fps": [16],
        // A14B rides the z16 Wan2.1 VAE: `patch (1,2,2)` × `vae_stride (4,8,8)` = **16**.
        // The constraint is the engines' own divisibility check — candle
        // `SIZE_MULTIPLE_14B = 16` enforced via `is_multiple_of`
        // (candle-gen-wan/src/config.rs:209, checked at wan14b.rs:635), and mlx's
        // `align_dim(patch, vae_stride)` (mlx-gen-wan/src/pipeline.rs:36, config.rs:169).
        // (The descriptor `min_size` agrees by convention, but it is only a lower BOUND —
        // gen-core checks `req.width < min_size` — not a lattice.) Only the dense TI2V-5B
        // needs 32 (its z48 VAE has vae_stride 16). Declaring 16 is the engine's truth and
        // keeps custom dims honest (sc-12294).
        //
        // The 720p buckets are TRUE 720p. `720 = 45·16` is on the stride above, and the A14B's
        // **area** cap is upstream's own `1280*720` = 921,600 (`MAX_AREA_CONFIGS[t2v-A14B]` in
        // Wan2.2's wan/configs/__init__.py — the same set i2v-A14B and Wan2.1's vace-14B get).
        // 1280x720 sits exactly AT the cap (the check is `>`), so it renders as advertised.
        //
        // These buckets read 1280x704 until sc-12308. That is the TI2V-5B's geometry, and it was
        // adopted here only because MAX_AREA_14B had borrowed the 5B's 901,120 budget — a number
        // whose 704 comes from the 5B's 32-px grid, not from any 14B limit. Being 2.3% low, it
        // excluded exactly the canonical 720p: candle hard-errored on it, mlx i2v silently refit it
        // to 1264x704, and the manifest was walked down to match rather than the cap questioned.
        //
        // `maxPixels` makes the cap ENFORCED rather than merely advertised: nothing in the app
        // validates against `resolutions`, so a raw over-cap request (job retry, MCP, preset replay)
        // reaches the engine untouched. The backends now AGREE — candle rejects above MAX_AREA_14B
        // (candle-gen-wan/src/wan14b.rs:645) and mlx rejects too (its T2V `max_area: 0` is gone;
        // model.rs `validate_impl` → `reject_over_area`), both at 921,600.
        "requiresDimensionsMultipleOf": 16,
        "maxPixels": 921600,
        "resolutions": ["832x480", "480x832", "1280x720", "720x1280"],
        // Epic 7114 curated menu (sc-7296). Base = the candle (Windows) A14B engine's curated
        // set (native `uni_pc`/`euler`); the macOS mlx override below exposes the full curated
        // fold-in. No scheduler axis (flow shift = `scheduler_shift`).
        "samplers": ["default", "uni_pc", "euler"],
        "schedulers": ["default"]
      },
      "loraCompatibility": { "sizeClass": "14b", "imageConditionedBackbone": false,
        "families": ["wan-video"],
        "types": ["style", "motion", "character", "enhance"]
      },
      // GGUF-quantized A14B experts for the torch adapter. A14B is GPU-heavy at bf16
      // (~56GB transformers), so quantization is the default on both platforms: Q8_0
      // on MPS (trivial dequant, ~3x slower vs ~13x for k-quants), Q4_K_M on CUDA
      // (smallest, fused kernel). Two experts: high-noise -> transformer, low-noise
      // -> transformer_2. Apache-2.0 weights (QuantStack GGUF).
      "quantization": {
        "defaults": { "mps": "gguf-q8_0", "cuda": "gguf-q4_k_m" },
        "variants": {
          "gguf-q8_0": {
            "format": "gguf",
            "label": "GGUF Q8_0 (near-lossless)",
            "repo": "QuantStack/Wan2.2-T2V-A14B-GGUF",
            "transformerFile": "HighNoise/Wan2.2-T2V-A14B-HighNoise-Q8_0.gguf",
            "transformer2File": "LowNoise/Wan2.2-T2V-A14B-LowNoise-Q8_0.gguf"
          },
          "gguf-q4_k_m": {
            "format": "gguf",
            "label": "GGUF Q4_K_M (smallest)",
            "repo": "QuantStack/Wan2.2-T2V-A14B-GGUF",
            "transformerFile": "HighNoise/Wan2.2-T2V-A14B-HighNoise-Q4_K_M.gguf",
            "transformer2File": "LowNoise/Wan2.2-T2V-A14B-LowNoise-Q4_K_M.gguf"
          }
        }
      },
      "mlx": {
        // Turnkey pre-converted dual-expert MLX snapshot on the SceneWorks HF org (sc-5607,
        // epic 5594) — replaces the third-party AITRADER/Wan2.2-T2V-A14B-mlx-bf16 mirror. As of the
        // quant matrix (sc-9942, epic 8506) it ships pre-built q4/q8/bf16 tier subdirs (each
        // self-contained: high/low-noise experts + UMT5 encoder + z16 VAE + tokenizer + config.json,
        // the quant baked in via config.json so nothing quantizes at load). The worker resolves env
        // override (SCENEWORKS_MLX_WAN14B_T2V_DIR) → local <data>/models/mlx/wan_2_2_t2v_14b → the
        // requested tier subdir of this snapshot (wan_t2v_14b_tier_subdir; both MoE experts live in
        // one subdir), loading with no install-time convert peak. Source Wan-AI/Wan2.2-T2V-A14B is
        // Apache-2.0; converter "wan_t2v_14b" (mlx-gen-wan convert_t2v_14b) builds each tier. The
        // mandatory lightx2v 4-step Lightning distill LoRA installs as a `coRequisite` above (sc-10030;
        // ensure_wan_lightning_present also self-heals a pre-coRequisite worker at gen time).

        "repo": "SceneWorks/wan2.2-t2v-a14b-mlx",
        // macOS curated menu (sc-7296): the full curated fold-in over the A14B native flow σ
        // schedule. No scheduler axis (flow shift = `scheduler_shift`).
        "limits": {
          "samplers": ["default", "uni_pc", "euler", "dpmpp_2m", "euler_ancestral", "heun", "dpmpp_sde", "ddim"],
          "schedulers": ["default"]
        }
      },
      // candle/CUDA VRAM gate — q4/q8/bf16 all MEASURED (sc-13174, completing the sc-12631 deferral after
      // the epic sc-12732 rework landed the 24 GB path). Taken on an idle RTX PRO 6000 (Blackwell sm_120) via
      // the candle-gen-wan VramProbe at the A14B's shipped 1280x720 / 81f / 4-step Lightning default, in the
      // SEQUENTIAL-offload residency the model now renders with: the two 14B MoE experts are swapped
      // one-resident-at-a-time (sc-12733), the bf16 UMT5 TE (sc-12778) is offloaded before denoise, and the
      // z16 bf16 VAE decode is tiled against free VRAM (sc-12734/12758/12818) — so at most ONE expert +
      // activations are live. The 24 GB lever was sc-12894 (8x-finer sdpa chunk; the denoise attention was
      // the floor). q4/q8/bf16 are the driver's TRUE concurrent-live peak (`CU_MEMPOOL_ATTR_USED_MEM_HIGH`,
      // sc-12818) in GiB — the honest figure; nvidia-smi reads the cudarc pool high-water (~27/37/49 GB, base-10
      // q4/q8/bf16, inflated — the pool never frees) and under-samples the attention transient. Each measured in
      // its own process. The peak is DENOISE-owned; the VAE decode adds only ~5 GiB.
      //
      // This model loads SEQUENTIAL, not resident: both bf16 experts co-resident is ~56 GiB + TE + VAE and
      // OOMs even a 96 GB card (the pre-rework pathology sc-12730 fixed), so there is no meaningful
      // resident peak — `video_load_spec` forces `OffloadPolicy::Sequential` for the A14B ids
      // (`video_jobs::candle_wan_offload_policy`) and these are that SEQUENTIAL peak. The gate is only
      // truthful because the load is coupled to it (pinned by the gpu_and_manifest tripwire). minMemoryGb
      // 24 gates the DEFAULT/lightest (q4) tier (22.13 + the gate's 2 GB headroom), which admits a 32 GB
      // RTX 5090 — the epic sc-12732 target. (The raw 22 GiB q4 peak physically fits a 24 GB card too, but
      // the conservative headroom targets ~26 GB free, so a 24 GB card is refused — the safe direction.)
      //
      // q8 (27.95) is gated at its LIVE peak, which is what admits a 32 GB card (sc-13174). Its live peak is
      // 27.95 GiB but its nvidia-smi POOL high-water is 36.9 GB (34.4 GiB) and cudarc never frees the pool, so
      // whether a ≤32 GB card packs down to the live peak IS the question. sc-13174 argued yes from a 64 GiB
      // balloon leaving ~31 GiB free: a valid clip, the SAME 27.95 GiB live peak, comparable wall time
      // (~2388 s vs the unconstrained 2427 s), and balloon(64) + live(28) = 92 < 96 GiB.
      //
      // ⚠️ THAT ARGUMENT DOES NOT HOLD, and the tier has NOT been re-measured (sc-16091 → sc-16118). Both
      // premises fail:
      //   1. The arithmetic is CIRCULAR. `balloon(64) + live(28) = 92 < 96` uses the LIVE figure, which is the
      //      correct figure only IF the pool trimmed — the very claim under test. Under the competing
      //      hypothesis it reads balloon(64) + high-water(34.4) = 98.4 > 95.6, a ~2.8 GiB overcommit.
      //   2. "A WDDM spill would inflate the wall time" is MEASURED FALSE on this host (sc-15791, 2026-07-30):
      //      a 3.41 GiB pool-reserved footprint ran with only 1.93 GiB driver-visible free — a 1.48 GiB
      //      overcommit — completing with a bit-identical peak at 1.07x, and FASTER in a sibling run. The
      //      driver absorbs the overage silently. Note sc-13174's own ballooned run was faster than
      //      unconstrained (2388 vs 2427 s), which under the old rule read as proof of no spill.
      // Both hypotheses predict everything observed, because USED_MEM_HIGH reports LIVE bytes and so reads
      // 27.95 either way. If the pool does NOT trim, q8's real footprint on a 32 GB card is ~34.4 GiB and this
      // gate OVER-ADMITS — a user OOMs on a card this manifest says fits. It may well be fine (pool trimming is
      // documented driver behaviour); it is simply not established. The value is LEFT UNCHANGED deliberately:
      // correcting it needs the measurement, not a comment edit. sc-16118 settles it under an ENFORCED ceiling
      // (`CUmemPoolProps.maxSize` + `cuDeviceSetMemPool`, proven in inference #335 to bind candle's allocator)
      // instead of a balloon, which is not a ceiling on this hardware.
      //   bf16 (38.56) is MEASURED (sc-13174): its dense fp32 `Wan-AI/*-Diffusers` snapshot was staged (the
      // missing transformer_2 + other fp32 shards downloaded) and run — one dense bf16 expert (~26 GiB,
      // 14B×2 B) + the shared ~12 GiB activation set. It replaces the old conservative DERIVED 56 bound: the
      // real 38.56 GiB live peak admits a 48 GB card the 56 bound refused, while staying refused on a 32 GB
      // card (40.56 > 32). Its pool high-water (48.8 GB ≈ 45.4 GiB) sits ABOVE the live peak like q8's does,
      // and no separate ≤48 GB balloon was run — so ⚠️ bf16-on-48 INHERITS the unproven q8 pool-trim inference
      // above in full, with no independent evidence of its own. Same treatment: value unchanged, sc-16118.
      "candle": {

      },
