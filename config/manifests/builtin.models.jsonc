      "gated": false,
      "requiresLicenseAcknowledgment": true,
      "licenseUrl": "https://huggingface.co/Qwen/Qwen-Image-2.1-Turbo/blob/fc13ba1986fcb905854dc8de2f52eee395f49b5b/LICENSE",
      // Base's notice, adapted to name Turbo and its NOTICE file: the LICENSE beside the pinned
      // Turbo weights is byte-identical to base's (sha256 8dc973f0…), so every clause cited holds.
      "licenseNotice": "Qwen-Image 2.1 Turbo's weights are governed (the same Agreement, byte for byte, as the base Qwen Image 2.1 model's) by the Qwen RESEARCH LICENSE AGREEMENT — not by SceneWorks' own AGPL-3.0 licence, and not by the Apache-2.0 terms that cover the separate \"Qwen Image\" (2512) model in this catalog. Three of its terms decide whether you may use this model at all. (1) NON-COMMERCIAL ONLY (§1(i), §2(a)): the licence grants you a non-exclusive, worldwide, non-transferable, royalty-free licence to use, reproduce, distribute and modify the model FOR NON-COMMERCIAL PURPOSES ONLY, where \"Non-Commercial\" means for research or evaluation purposes only. §2(b) requires a separate commercial licence from Hangzhou Tongyi Laboratory, requested at model-business@notice.qwencloud.com, for any commercial use. (2) NO \"QWEN\" NAMING, AND ATTRIBUTION ON DERIVED MODELS (§4(b), §4(c)): if you use this model or anything it produces to create, train, fine-tune or improve an AI model that you distribute or make available, you must prominently display \"Built with Qwen\" or \"Improved using Qwen\" in that product's documentation; and you may not use \"Qwen\" as the primary name of a derivative work, though descriptive use such as \"fine-tuned from Qwen Image\" is permitted. SceneWorks ships a LoRA trainer and a training studio, so this is the restriction the product's own features are most likely to reach. (3) REDISTRIBUTION CARRIES THE AGREEMENT (§3): if you pass the weights or a derivative on, you must include a copy of this Agreement, mark any files you changed, and retain the attribution notice \"Qwen is licensed under the Qwen RESEARCH LICENSE AGREEMENT, Copyright (c) 2026 Hangzhou Tongyi Laboratory Technology Co., Ltd. All Rights Reserved.\" The bf16 tier is downloaded from Qwen's own Qwen-Image-2.1-Turbo repository into your machine on first use, so SceneWorks redistributes nothing there. The q8 and q4 tiers ARE re-hosted by SceneWorks: they are quantized derivatives, §3 therefore applies to them, and SceneWorks discharges it by shipping a copy of this Agreement, a CHANGES.md change record naming exactly which files were changed, a SHA256SUMS manifest of those files, and the attribution notice above (also as a NOTICE file) inside each tier's own directory. SceneWorks never embeds any of these weights in a build or an installer. The licence is SILENT on the images you generate: §2(a)'s restriction is on the Materials (the weights, code and documentation), and no clause restricts outputs, so SceneWorks does not read one in. Read the full text at the link below before downloading.",
      // Feeds the packaging NC-weights guard (scripts/check-no-nc-weights.mjs), as base's does.
      "nonCommercial": true,
      "defaults": {
        // The distilled schedule's own operating point: 8 steps (the snapshot's saved
        // `sample_sigmas`), guidance 1.0 (true-CFG off until a negative prompt is supplied), the
        // engine's 1:1 preset, one image, and the `default` sampler/scheduler — `default` is what
        // keeps the saved distilled sigmas; a curated scheduler name replaces them.
        "resolution": "2048x2048",
        "steps": 8,
        "guidanceScale": 1.0,
        "count": 1,
        "sampler": "default",
        "scheduler": "default"
      },
      "limits": {
        // Base's request envelope, verbatim — the descriptor is base's under a second id: the
        // seven presets in engine order, count up to 8, the [32, 2752] ÷32 free-size envelope
        // (enforced at enqueue because all three keys are declared), and 1-10 ordered references
        // counted over the flattened list.
        "resolutions": [
          "2048x2048",
          "2400x1792",
          "1792x2400",
          "2528x1696",
          "1696x2528",
          "2752x1536",
          "1536x2752"
        ],
        "count": [1, 2, 4, 8],
        "minDimension": 32,
        "maxDimension": 2752,
        "requiresDimensionsMultipleOf": 32,
        "maxReferenceAssets": 10,
        // A PRODUCT floor of 4 steps, set from the epic's terminal step sweep on real weights
        // (sc-25909): 4, 6, 8, 12 and 16 steps all rendered coherent, so 4 is the lowest count
        // MEASURED to hold up. The engine itself would accept 1 (a distilled curve resampled to
        // one step is still a legal schedule), but nothing below 4 was swept, and the floor is
        // never set below evidence. Step counts other than 8 are a resample of the saved
        // distilled curve.
        "hardMinSteps": 4,
        // Base's curated solver menu, verbatim (both providers publish the same menu under the
        // Turbo id). ⚠️ On this id a non-`default` SCHEDULER replaces the distilled sigmas with
        // that scheduler's own unshifted curve; `default` keeps them.
        "samplers": ["default", "euler", "euler_ancestral", "heun", "dpmpp_2m", "dpmpp_2m_sde", "dpmpp_sde", "er_sde", "uni_pc", "lcm", "ddim"],
        "schedulers": ["default", "normal", "simple", "karras", "exponential", "sgm_uniform", "beta", "ddim_uniform", "beta57"]
