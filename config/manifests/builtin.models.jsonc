          "platforms": ["macos"],
          "estimatedSizeBytes": 42696802013,
          "footprint": { "diskSizeBytes": 42696802013, "residentMemoryBytes": null, "peakMemoryBytes": null }
        },
        {
          "provider": "huggingface",
          "repo": "SceneWorks/wan2.2-i2v-a14b-mlx",
          "revision": "c6c786170031eccc3a1fac0f98f1ad4ff988271e",
          "variant": "bf16",
          "files": ["bf16/*"],
          "platforms": ["macos"],
          // Dense bf16 tier (sc-9943): both experts bf16 + T5 + VAE + tokenizer — the same content as
