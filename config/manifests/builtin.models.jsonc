      ],
      "paths": {
        "model": "${HF_CACHE}/SceneWorks/wan2.2-i2v-a14b-mlx"
      },
      "defaults": {
        "duration": 5,
        "fps": 16,
        "resolution": "1280x720",
        "quality": "balanced",
        "sampler": "default",
        "scheduler": "default"
      },
      "limits": {
        "durations": [3, 4, 5],
        "recommendedMaxDuration": 5,
        "hardMaxDuration": 5,
        "fps": [16],
        // Same z16 A14B geometry as the T2V entry above: patch 2 × vae_stride 8 = **16**
        // (candle `SIZE_MULTIPLE_14B` at config.rs:209 via `is_multiple_of`; mlx `align_dim`
        // at pipeline.rs:36) (sc-12294).
        //
        // Shares the 14B family's upstream `1280*720` = 921,600 budget (`MAX_AREA_CONFIGS[i2v-A14B]`),
        // so 1280x720 is at the cap and renders as advertised.
        //
        // I2V was where the old 901,120 did the most damage: candle hard-errored on 1280×720 while
        // mlx silently REFIT it to 1264×704 — a geometry on no advertised bucket (the fit's
        // aspect-distortion metric prefers it over the at-cap 1280×704). Both are gone: the cap now
        // carries the 14B's real budget, and mlx rejects rather than refits (sc-12308).
        "requiresDimensionsMultipleOf": 16,
        "maxPixels": 921600,
        "resolutions": ["832x480", "480x832", "1280x720", "720x1280"],
        // Epic 7114 curated menu (sc-7296). Base = the candle (Windows) A14B engine's curated
        // set (native `uni_pc`/`euler`); the macOS mlx override below exposes the full curated
        // fold-in. No scheduler axis (flow shift = `scheduler_shift`).
        "samplers": ["default", "uni_pc", "euler"],
        "schedulers": ["default"]
      },
      "loraCompatibility": {
        "families": ["wan-video"],
        "types": ["style", "motion", "character", "enhance"]
      },
      // GGUF-quantized A14B experts for the torch adapter. Same rationale as the T2V
      // entry: quantized by default (Q8_0 on MPS, Q4_K_M on CUDA), two experts
      // (high-noise -> transformer, low-noise -> transformer_2). Apache-2.0 weights.
      "quantization": {
        "defaults": { "mps": "gguf-q8_0", "cuda": "gguf-q4_k_m" },
        "variants": {
          "gguf-q8_0": {
            "format": "gguf",
            "label": "GGUF Q8_0 (near-lossless)",
            "repo": "QuantStack/Wan2.2-I2V-A14B-GGUF",
            "transformerFile": "HighNoise/Wan2.2-I2V-A14B-HighNoise-Q8_0.gguf",
            "transformer2File": "LowNoise/Wan2.2-I2V-A14B-LowNoise-Q8_0.gguf"
          },
          "gguf-q4_k_m": {
            "format": "gguf",
            "label": "GGUF Q4_K_M (smallest)",
            "repo": "QuantStack/Wan2.2-I2V-A14B-GGUF",
            "transformerFile": "HighNoise/Wan2.2-I2V-A14B-HighNoise-Q4_K_M.gguf",
            "transformer2File": "LowNoise/Wan2.2-I2V-A14B-LowNoise-Q4_K_M.gguf"
          }
        }
      },
      "mlx": {
        // Turnkey pre-converted dual-expert MLX snapshot on the SceneWorks HF org (sc-5600,
        // epic 5594). As of the quant matrix (sc-9943, epic 8506) it ships pre-built q4/q8/bf16 tier
        // subdirs (each self-contained: high/low-noise experts at in_dim 36 image-concat + UMT5
        // encoder + z16 VAE + tokenizer + config.json, the quant baked in via config.json so nothing
        // quantizes at load). The worker resolves env override (SCENEWORKS_MLX_WAN14B_I2V_DIR) →
        // local <data>/models/mlx/wan_2_2_i2v_14b (a local conversion supersedes) → the requested
        // tier subdir of this snapshot (wan_a14b_tier_subdir; both MoE experts live in one subdir),
        // loading with no install-time convert peak. Source Wan-AI/Wan2.2-I2V-A14B is Apache-2.0;
        // converter "wan_i2v_14b" (mlx-gen-wan convert_i2v_14b) builds each tier. Its distill LoRA is
        // applied at run time.
        "minMemoryGb": 133,
        // Same tier-invariant sequential expert-swap topology as the T2V sibling above.
        "measuredSiblingActiveDiskFraction": 0.5,
        "repo": "SceneWorks/wan2.2-i2v-a14b-mlx",
        // macOS curated menu (sc-7296): the full curated fold-in over the A14B native flow σ
        // schedule. No scheduler axis (flow shift = `scheduler_shift`).
        "limits": {
          "samplers": ["default", "uni_pc", "euler", "dpmpp_2m", "euler_ancestral", "heun", "dpmpp_sde", "ddim"],
          "schedulers": ["default"]
        }
      },
      // candle/CUDA VRAM gate (sc-12631 + sc-13174, post epic sc-12732). The image→video twin of the
      // T2V-A14B block above; see that comment for the harness, the SEQUENTIAL-offload residency the numbers
      // are taken under (`OffloadPolicy::Sequential` forced for the A14B ids), the `USED_MEM_HIGH`
      // methodology, and the q8 ≤32 GB balloon validation + bf16 dense-stage measurement (`measured: true`,
      // sc-13174). Measured at the same 1280x720 / 81f / 4-step Lightning default. The I2V live peaks sit
      // ~0.1 GiB above T2V's: the experts are the same shape (config `i2v_14b()` differs only in
      // `in_channels` 36 vs 16 — the image concat — not the 40-layer/40-head attention that IS the peak), and
      // the VAE ENCODER is additionally resident here (`WanVae16::new_with_encoder`) to latent-encode the
      // first frame. minMemoryGb 24 gates the DEFAULT (q4) tier + 2 GB headroom → q4 admits a 32 GB card. q8
      // (28.02 live; nvidia-smi pool high-water 38.2 GB / 35.6 GiB) admits a 32 GB card the same way as T2V —
      // a 64 GiB balloon left ~31 GiB free and the render kept the 28.02 live peak in comparable wall time.
      // ⚠️ It therefore inherits the T2V block's UNPROVEN pool-trim inference in full: that balloon argument is
      // circular (it substitutes the live figure for the one under test) and its "a spill would inflate wall
      // time" premise is measured false on this host (sc-15791). If the pool does not trim, q8's real footprint
      // here is ~35.6 GiB and the 32 GB admission is wrong. bf16 (38.62, measured from the dense fp32 stage;
      // pool high-water 48.9 GB / 45.5 GiB) replaces the old derived 56 — its 38.62 live peak admits a 48 GB
      // card (refused on 32) on that same unproven basis. Values LEFT UNCHANGED pending sc-16118, which
      // re-validates both under an ENFORCED pool cap rather than a balloon. See the T2V block for the detail.
      "candle": {
        "minMemoryGb": 24,
        "vramGbByTier": { "q4": 22.20, "q8": 28.02, "bf16": 38.62 },
