      // Non-commercial: distributed under the CircleStone Labs Non-Commercial License v1.2. The source
      // repo `circlestone-labs/Anima` is UN-gated (freely downloadable) but NC — generations are for
      // non-commercial use only. `nonCommercial: true` feeds the packaging NC-weights guard
      // (scripts/check-no-nc-weights.mjs, sc-10526) its family tokens from THIS manifest entry.
      //
      // Convert-at-install (sc-10517): SceneWorks never redistributes converted Anima weights, so the
      // worker packs the Cosmos DiT ON-DEVICE to the full q4/q8/bf16 matrix from the ungated `split_files/`
      // source (the conditioner + Qwen3 TE + Qwen-Image VAE stay dense bf16 in every tier). `downloads`
      // enumerate the THREE exact source files this variant needs (its DiT + the two shared components) —
      // NEVER the bare repo, which holds SEVEN full bf16 DiTs (~30 GB vs ~5.6 GB). The 5 distinct source
      // paths across the three variants match the `ANIMA_DIT_FILES`/`ANIMA_TE_FILE`/`ANIMA_VAE_FILE`
      // constants asserted by `source_file_plan_is_five_exact_paths_never_the_bare_repo` (sc-10517).
      "autoDownload": false,
      "name": "Anima 2B",
      "family": "anima",
      "type": "image",
      "adapter": "mlx_anima",
      "capabilities": ["text_to_image"],
      "captionStyle": "tags",
      "macOnly": false,
      "nonCommercial": true,
      "gated": false,
      "downloads": [
        {
          // macOS convert source (sc-10517): the base variant's Cosmos DiT + the two shared components.
