        "minMemoryGb": 64,
        "quantize": 8,
        "repo": "SceneWorks/boogu-image-mlx"
      },
      // Direct CUDA probes on RTX PRO 6000 Blackwell, exclusive GPU, 1024², seed 42, native 50-step
