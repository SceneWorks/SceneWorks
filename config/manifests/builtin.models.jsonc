    {
      "id": "illustrious_xl_v1",
      "name": "Illustrious-XL v1.0 (anime)",
      "family": "sdxl",
      "type": "image",
      "adapter": "sdxl_diffusers",
      // Danbooru-tag anime SDXL finetune (OnomaAI). Architecturally vanilla SDXL — identical UNet,
