          "estimatedSizeBytes": 2504
        },
        // sc-19573 — THE SIBLING DiT PARTITION, mirrored. This entry's primary is `transformer_ref/`,
        // so the base `transformer/` is the half it must additionally pull: the engine opens both on
        // every load, so a Ref2VA-only install was as unloadable as a text-to-video-only one.
        {
          "provider": "huggingface",
          "repo": "SceneWorks/minimax-h3-mlx",
          "revision": "137ce668c55a20bc0935fd1cf2a3de8448abb7f4",
          "variant": "q4",
          "coRequisite": true,
          "files": ["q4/transformer/*"],
          "platforms": ["macos"],
          "estimatedSizeBytes": 18780109783
        },
        {
          "provider": "huggingface",
          "repo": "SceneWorks/minimax-h3-mlx",
          "revision": "137ce668c55a20bc0935fd1cf2a3de8448abb7f4",
          "variant": "q8",
          "coRequisite": true,
          "files": ["q8/transformer/*"],
          "platforms": ["macos"],
          "estimatedSizeBytes": 35302064357
        },
        {
          "provider": "huggingface",
          "repo": "SceneWorks/minimax-h3-mlx",
          "revision": "137ce668c55a20bc0935fd1cf2a3de8448abb7f4",
          "variant": "bf16",
          "coRequisite": true,
          "files": ["bf16/transformer/*"],
          "platforms": ["macos"],
          "estimatedSizeBytes": 66280569250
        }
        // NO OFF-MAC ROWS HERE, and that is deliberate rather than an omission (sc-19558).
        // `minimax_h3` gained a `platforms: ["windows", "linux"]` raw-snapshot set because
        // `candle-gen-minimax-h3` implements t2va + fl2va.
        //
        // ⚠️ sc-20267 CORRECTION — THE ORIGINAL REASON IS STALE AND MUST NOT BE RESTATED. It read:
        // "the candle provider DEFAULT-DENIES `ref2va` at its conditioning allowlist until sc-17157
        // ports `transformer_ref`, so an off-Mac row here would advertise weights for a mode the only
        // off-Mac engine refuses." sc-17157 LANDED (inference `32204c935`, "port Ref2VA multi-modal
        // references to candle") and is an ancestor of the revision this repository pins, so the
        // pinned candle engine advertises ALL THREE reference conditioning kinds — `Reference`,
        // `ReferenceVideo` and `ReferenceAudio` — in its descriptor's allowlist. There is no engine
        // refusal to cite.
        //
        // WHAT ACTUALLY KEEPS THE OFF-MAC ROWS ABSENT TODAY, both of which are about this repository
        // rather than the engine:
        //   1. every `transformer_ref` row is `macos`-ONLY — this entry's three primaries and the three
        //      sibling co-requisites on `minimax_h3` alike — and they all live in
        //      `SceneWorks/minimax-h3-mlx`, while the off-Mac bf16 route reads raw upstream. So
        //      declaring an off-Mac Ref2VA set means first deciding which route serves `transformer_ref`
        //      at which tier off-Mac. That platform split is sc-19573's concern; sc-20267 widened only
        //      the base `transformer` tiers and deliberately left every `transformer_ref` row alone; and
        //   2. there is still no candle dispatch arm — `crates/sceneworks-worker/src/video_jobs/
        //      minimax_h3.rs` is `#[cfg(target_os = "macos")]` end to end — and this entry still has no
        //      measured off-Mac VRAM ceiling of its own.
        // Add the rows in the same change that resolves those two, not before.
      ],
      "paths": {
        "model": "${HF_CACHE}/SceneWorks/minimax-h3-mlx"
      },
      // sc-18725 — see `minimax_h3` for what each key is read by. Declared HERE too and identically:
      // the two partitions are one DiT architecture with one geometry, and the gate is per-model-id,
      // so omitting it would leave Ref2VA unable to take the very adapter distilled for it
      // (`minimax_h3_ref2v_turbo_4step`). The values match `minimax_h3` exactly on purpose — family
      // membership cannot express the fl2v-vs-ref2v pairing, which is a labelling convention today
      // rather than an enforced constraint (tracked on sc-19563).
      "loraCompatibility": {
        "families": ["minimax-h3"],
        "types": ["style", "motion", "character", "enhance"]
      },
      "defaults": {
        "duration": 5.1667,
        "fps": 24,
        "resolution": "1344x768",
        "steps": 50,
        "sampler": "default",
        "scheduler": "default"
      },
      "limits": {
        // Identical geometry to `minimax_h3` — same DiT architecture, same VAE, same lattice. See
        // that entry for the derivations; the two are asserted equal by
        // `both_minimax_h3_partitions_declare_one_geometry`.
        "durations": [5.1667, 5.875, 6.5833, 7.2917, 8.0, 8.7083, 9.4167, 10.125, 10.8333, 11.5417, 12.25, 12.9583, 13.6667, 14.375],
        "hardMinDuration": 5.1667,
        "hardMaxDuration": 14.375,
        "recommendedMaxDuration": 14.375,
        // Same scheduler, same two-EVALUATION floor as `minimax_h3` — see that entry for the unit
        // (NFE, not sigma grid points) and for why 2 is a product judgement rather than an engine
        // limit (sc-19426, corrected sc-18726).
        "hardMinSteps": 2,
        "fps": [24],
        "maxPixels": 1032192,
        "resolutions": ["1536x672", "672x1536", "1344x768", "768x1344", "1024x768", "768x1024", "768x768", "576x320", "320x576"],
        // Ref2VA's real caps. The per-list numbers do NOT multiply out to the combined one — 9 + 3
        // + 3 is 15 files against a 12-file ceiling — which is why `maxCombinedReferenceAssets` is
        // its own key rather than something derived: it is the only cap that can refuse a request in
        // which every individual list fits (sc-17160).
        "maxReferenceAssets": 9,
        "maxSourceClipAssets": 3,
        "maxReferenceAudioAssets": 3,
        "maxCombinedReferenceAssets": 12,
        "samplers": ["default"],
        "schedulers": ["default"]
      },
      "mlx": {
        // Same floor, same derivation as `minimax_h3` (sc-17153) — the ref DiT partition is
        // byte-identical to the base one at every tier, the packed q4 conditioning encoder is
        // shared, and the geometry envelope is asserted equal by
        // `both_minimax_h3_partitions_declare_one_geometry`, so the denoise-transient term that
        // binds at the envelope top is the same. The reference presentation adds vision-tower
        // work to the CONDITIONING stage only, which sits ~32 GB under the binding denoise stage
        // even with generous headroom, so it cannot move the max. The old 96 priced the retired
        // dense-TE stage — see the base entry's derivation comment for the full arithmetic and
        // for what the terminal measurement campaign still owes both entries.
        "minMemoryGb": 64,
        "repo": "SceneWorks/minimax-h3-mlx",
        "limits": {
          "samplers": ["default"],
          "schedulers": ["default"]
        }
      },
      // NO `candle` block HERE — and as of sc-20267 the reason is the SAME KIND as `minimax_h3`'s (a
      // missing measurement plus a missing dispatch arm), not a different kind.
      //
      // ⚠️ sc-20267 CORRECTION — WHAT THIS COMMENT USED TO CLAIM IS FACTUALLY FALSE AGAINST THE PIN.
      // sc-17156 wrote that the reason was "a REFUSAL IN CODE rather than a missing measurement":
      // that the candle provider "serves the `transformer` checkpoint only", that `ref2va` is
      // "DEFAULT-DENIED at the descriptor's conditioning allowlist — `Reference`, `ReferenceVideo` and
      // `ReferenceAudio` are deliberately absent", and that `Capabilities::validate_request` therefore
      // turns a reference request into a typed `Unsupported`. sc-17157 landed that port (inference
      // `32204c935`, "port Ref2VA multi-modal references to candle": the `transformer_ref` partition,
      // the omni-reference presentation and the audio VAE encoder) and it is an ANCESTOR of the
      // revision this repository pins — so the pinned candle engine advertises all three reference
      // conditioning kinds and there is no refusal to point at. The old text is quoted rather than
      // deleted because it is cited elsewhere as the reason this entry has no candle surface; anyone
      // who finds that citation should land here and stop.
      //
      // THE HONEST CURRENT REASON, and it is exactly two things:
      //   1. NO MEASURED VRAM CEILING for this entry on the candle lane. It needs its own, not a copy
      //      of `minimax_h3`'s, because the reference presentation adds an encode stage the base
      //      partition never runs — and `minimax_h3`'s own candle block still carries `measured: false`
      //      for a probe that has never been executed, so there is nothing to copy even if copying
      //      were sound; and
      //   2. NO CANDLE DISPATCH ARM — `crates/sceneworks-worker/src/video_jobs/minimax_h3.rs` is
      //      `#[cfg(target_os = "macos")]` end to end for BOTH partitions.
      // Neither is a statement about what the engine can do; both are about what this repository can
      // yet prove and route. See also the trailing note in `downloads` above for why this entry
      // declares no off-Mac rows.
      "ui": {
        "label": "MiniMax-H3 References",
        // §IV.2 attribution, same as `minimax_h3` — see that entry for the citation (sc-17227).
        "attribution": "Powered by MiniMax H3",
        // sc-17162 — the same honesty pass as `minimax_h3`, carried in full rather than by
        // reference. The two entries are separate model cards and a user can install THIS one
        // without ever reading that one's, so "see the other entry" would leave the withheld
        // components undisclosed on the surface where the decision is actually made.
        "description": "The reference-conditioned half of MiniMax-H3: give it up to 9 images, 3 video clips and 3 audio clips (12 files in total) and it renders a new clip — with synchronized stereo audio — that carries those subjects, motions and voices. It uses a second checkpoint from the same family, so installing it adds the reference DiT alongside whatever text-to-video tiers you already have; the text encoder and both VAEs are shared and download only once. Same open-weights caveats as MiniMax-H3, and they are not small: the hosted prompt-understanding front end (H3-Context-IR) and the 2K in-context upscaler (H3-Regenerate-2K) are unreleased, so prompt adherence differs from the Hailuo API and 2K is not reachable from these weights; sparse-attention inference is unreleased too, so attention runs dense and the shortest clip at the default 1344x768 canvas is about a two-hour render. There is no guidance scale and no negative prompt. Clips come in the same fourteen fixed lengths between 5.17s and 14.38s — 15s is refused rather than shortened — and there is no still-image mode.",
        "recommendedFor": ["reference_to_video"],
        "durationHint": "Same fourteen clip lengths as MiniMax-H3, 5.17s to 14.38s at 24fps — nothing in between renders and 15s is refused rather than shortened to 14.38s — and the same canvas-dominated cost, so start at 576x320.",
        "promptGuide": {
          "title": "MiniMax-H3 Prompt Guide",
          "path": "/prompt-guides/minimax-h3.md",
          "sources": [
            { "label": "MiniMax-H3 model card", "url": "https://huggingface.co/MiniMaxAI/MiniMax-H3" },
            { "label": "Hailuo 3.0 prompting guide", "url": "https://hailuoai.video/" },
            { "label": "MiniMax platform video generation docs", "url": "https://platform.minimax.io/docs/api-reference/video-generation" }
          ]
        }
      }
    },
    {
      "id": "instantid_face_stack",
