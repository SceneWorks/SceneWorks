            { "label": "lightx2v Qwen-Image-Edit-2511-Lightning", "url": "https://huggingface.co/lightx2v/Qwen-Image-Edit-2511-Lightning" },
            { "label": "Qwen-Image-Lightning GitHub", "url": "https://github.com/ModelTC/Qwen-Image-Lightning" }
