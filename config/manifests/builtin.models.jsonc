          "title": "Anima Prompt Guide",
          "path": "/prompt-guides/anima.md",
          "sources": [
            { "label": "Anima model card (CircleStone Labs)", "url": "https://huggingface.co/circlestone-labs/Anima" }
          ]
        }
      }
