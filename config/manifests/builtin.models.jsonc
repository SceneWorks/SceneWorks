          "estimatedSizeBytes": 33723765614
        },
        {
          "provider": "huggingface",
          "repo": "MiniMaxAI/MiniMax-H3",
          "revision": "939557dc319dd91227e30195a763f272ba7f8765",
          "variant": "bf16",
          "coRequisite": true,
          "componentId": "text_encoder",
          "subdir": "text_encoder",
          "files": [
            "text_encoder/config.json",
            "text_encoder/model.safetensors.index.json",
            "text_encoder/tokenizer.json",
            "text_encoder/tokenizer_config.json",
            "text_encoder/vocab.json",
            "text_encoder/merges.txt",
            "text_encoder/chat_template.json",
            "text_encoder/preprocessor_config.json",
