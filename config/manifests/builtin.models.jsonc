      // This catalog id resolves through the z_image_turbo engine. The declaration is intentionally
      // route-local: it admits only edit/img2img with plain or replayable LoRA state and cannot
      // widen the base Z-Image or Turbo text/control populations.
      "mlx": {
        "minMemoryGb": 40,
        "quantize": 4,
        "standardTierLayout": true,
        "memoryStrategyContract": {
          "abi": 1,
          "provider": "z_image_turbo",
          "implementations": [
            {
              "rung": "bounded_transformer_residency",
              // Same provider implementation as the Turbo MLX declaration above, so it carries that
              // provider's fingerprint and parameter domain at the current pin (v4 + the widened
              // decode-tile ladder). Only the mode/overlay population is narrowed here.
              "fingerprint": "z-image-mlx-independent-materialization-v4",
              "tiers": ["bf16", "q4", "q8"],
              "modes": ["edit_image", "image_to_image"],
              "overlays": ["none", "lora"],
              "engagedRungs": ["resident", "bounded_decode", "bounded_attention", "bounded_transformer_residency"],
              "parameters": { "decodeTileEdge": 512, "decodeOverlap": 64, "attentionChunkSize": 67108864, "transformerWindowSize": 1, "transformerWindowComponent": "Dit" },
              "parameterRanges": { "decodeTileEdges": [2048, 768, 640, 512, 448, 384, 320, 256], "decodeOverlaps": [256, 64], "attentionChunkSizes": [67108864], "transformerWindowSizes": [1], "transformerWindowComponents": ["Dit", "TextEncoder", "Both"] },
              "source": "inference:crates/media/mlx-gen/mlx-gen-z-image/src/memory_strategy.rs"
            }
          ]
        }
      },
