      "limits": {
        // One 81-frame driving segment ≈ 5s at 16fps (longer clips stitch segments —
        // each is a full 14B denoise, so keep clips short). Core aligns W×H to a
        // multiple of 32 — mlx's hardcoded `DIM_ALIGN = 32` (mlx-gen-scail2/src/generate.rs:73),
        // which core's default floor already matches, so no stride is declared. Engine
        // max_size 1280. The output bucket should match the driving clip's aspect (the
        // clip sets the motion + framing).
        //
        // Area: candle shares the 14B envelope — `reject_over_area` rejects above MAX_AREA_14B
        // (candle-gen-scail2/src/pipeline.rs:294), added because `max_size` alone only bounds each
        // EDGE, so 1280×1280 slipped through. That cap is now the 14B family's real 921,600, up
        // from the TI2V-5B's 901,120 it had borrowed (sc-12308).
        //
        // Raising it does NOT give SCAIL-2 720p, and that is expected: its buckets stay 704-tall
        // because of its own `DIM_ALIGN = 32` tiling grid above — 720 is off THAT lattice, an
        // unrelated constraint from the area. 1280x704 (901,120) remains its largest legal bucket
        // (the next 32-aligned step, 1280x736, is 942,080 — over the cap).
        "durations": [3, 4, 5],
        "recommendedMaxDuration": 5,
        "hardMaxDuration": 5,
        "fps": [16],
        "maxPixels": 921600,
        "resolutions": ["832x480", "480x832", "1280x704", "704x1280"],
        "samplers": ["default"],
        "schedulers": ["default"]
