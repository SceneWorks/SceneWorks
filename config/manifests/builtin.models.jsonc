      // candle/CUDA VRAM gate (epic 10765). ALL TIERS DIRECTLY MEASURED on an RTX PRO 6000 (Blackwell
      // sm_120) at 1024²/4-step CFG-free via the candle-gen-flux2 klein offload A/B harness
      // (flux2_klein_probed_generate_for_offload_ab, device-level nvidia-smi PeakSampler on an idle GPU 0),
      // two separate processes per tier (resident vs sequential), the FLUX.2-dev (sc-10920) methodology.
      // bf16 = sc-11008; q4/q8 = sc-11031 after candle klein DiT quant landed (candle-gen #422 — the 9B
      // DiT quantizes on-the-fly, the 8B Qwen3 TE stays dense in EVERY tier, DENSE_TE). vramGbByTier =
      // RESIDENT (TE + DiT + VAE co-resident); sequentialPeakGb = TE dropped before the DiT loads. Pixels
      // byte-identical resident vs sequential per tier (md5 q4 69cbac63 / q8 7fb8686f / bf16 4e36816e).
      // MEASURED (MiB/1024): q4 res 47300=46.2 / seq 24740=24.2; q8 res 51812=50.6 / seq 29380=28.7;
      // bf16 res 77284=75.5 / seq 54564=53.3. The ~22 GB reclaim is CONSTANT across tiers because candle
      // runs at dtype=F32, so the dense Qwen3 TE is ~32 GB F32 resident (NOT ~16 GB bf16) and IS the
      // sequential floor — dropping it dominates the reclaim regardless of DiT tier. This CORRECTS the
      // sc-11008 re-anchored ESTIMATES (q4 63.5/41.3, q8 67.6/45.4), which under-counted the F32 TE by
      // ~17–23 GB. Behavior: on the epic's 8–16 GB target cards klein rejects every tier (the 32 GB F32
      // TE alone overflows them); even q4 needs ~24 GB sequential, so off-Mac klein is a big-card/offload
      // family. minMemoryGb 25 ≈ the q4 sequential floor; the dynamic fit-gate drives the per-card decision.
      "candle": {
        // SC-15831: the provider-owned implementation is shared by the base, KV, and True V2
        // catalog entries because all three resolve to the same Candle engine. Evidence remains
        // entry-specific: only an exact artifact/tier/mode calibration may activate a candidate.
        // Klein's 1024/1 decode tuple is intentionally full-edge: smaller tile domains fail the
        // provider's real-weight RGB parity contract because the VAE tail contains spatial GroupNorm.
        "supportsSequentialOffload": true,
        "memoryStrategyCapabilities": {
          "bounded_decode": {
            "parameters": { "decodeTileEdge": 1024, "decodeOverlap": 1 },
            "overlays": ["none"]
          },
          "bounded_attention": {
            "parameters": { "attentionChunkSize": 67108864 },
            "overlays": ["none"]
          },
          "bounded_transformer_residency": {
            "parameters": { "transformerWindowSize": 1, "transformerWindowComponent": "Dit" },
            "overlays": ["none"]
          }
        },
        "minMemoryGb": 25,
        "vramGbByTier": { "q4": 46.2, "q8": 50.6, "bf16": 75.5 },
        "vramMeasuredPixels": 1048576,
        "sequentialPeakGb": { "q4": 24.2, "q8": 28.7, "bf16": 53.3 },
        "measured": true,
        // BEGIN generated-from-engine-capabilities — scripts/generate-manifest-memory-declarations.mjs
