      // de62f67b175ca91519602d5e024baf5342907b9fbe8d1297ad5abb561748bac9) emitted the validated
      // overallPeakGb=102.115 marker after proving a stable 0.020 GB idle baseline. minMemoryGb is
      // ceil(102.115 + the shared 2 GB dedicated-VRAM reserve) = 105; there is no lower Candle tier
      // or sequential-offload path, so both worker modes fail closed below that live free-VRAM floor.
      "candle": {
        "minMemoryGb": 105,
        "vramGbByTier": { "bf16": 102.115 },
        "vramMeasuredPixels": 399360,
        "measured": true
      },
      "ui": {
        "label": "SCAIL-2",
        "description": "zai-org SCAIL-2 character animation: give a reference character image and a driving video, and SCAIL-2 animates your character with the driving motion (the driving clip sets the motion and timing). Built on Wan2.1-14B; native MLX on macOS and native Candle on NVIDIA Windows/Linux using the same dense bf16 package. Candle needs at least 105 GB of free GPU VRAM (102.115 GB measured render peak plus reserve); lower-memory NVIDIA cards are rejected before load. Runs minutes-per-clip (segmented 14B denoise).",
