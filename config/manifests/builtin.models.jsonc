        "schedulers": ["default", "normal", "simple", "karras", "exponential", "sgm_uniform", "beta", "ddim_uniform", "beta57"]
      },
      "loraCompatibility": {
        // Anima LoRA/LoKr (sc-10521): the trained adapter targets the Cosmos DiT AND the bundled
        // `llm_adapter` conditioner, applied via `apply_anima_adapters`. Quant + LoRA TOGETHER is
        // unsupported (sc-10578 — the engine `load()` errors on the combination).
        "families": ["anima"],
        "types": ["style", "character"]
      },
      "mlx": {
        // 2B Cosmos DiT + 0.6B Qwen3 TE + Qwen-Image VAE — small. Convert-at-install packs the DiT to the
        // q4/q8/bf16 matrix on-device (the offline 2B quantize peaks a few GB); default q4. minMemoryGb 16
        // covers both the convert peak and a 1536² generate.
        "minMemoryGb": 16,
        "quantize": 4,
        // Per-model quality FLOOR (sc-10731, epic 10721): the minimum-fidelity tier the DEFAULT resolution
        // may land on. Anima base renders WASHED/smudged at q4 under CFG 4.5 × 30 steps (sc-10714 — q4
        // weight-quant error is amplified), so the app-wide default (and a low global "default quality"
        // setting) clamps UP to q8 here rather than silently landing on q4. This REPLACES the sc-10714
        // `anima_tier_subdir` q8 hardcode: the q8 default is now floor-driven, not a resolver special-case.
        // An EXPLICIT q4 pick in the Studio picker is still honored (a quant tier is a creative choice) —
        // the web surfaces a non-blocking advisory instead. Turbo omits this floor (it is CFG-free, so q4
        // is acceptable there).
        "minQualityTier": "q8",
        "requiresConversion": true,
        "converter": "anima_quant",
        "convertSourceRepo": "circlestone-labs/Anima",
        // epic-10285 staleness: the converted artifact is stale (needs re-convert) once THIS source file
        // is no longer in the HF cache. Must be one of `ANIMA_DIT_FILES` (validated by the convert plan).
        "convertSourceFile": "split_files/diffusion_models/anima-base-v1.0.safetensors",
        // SC-15524: pinned export of the shared memory-strategy contract implemented by
        // mlx-gen-anima. Anima is the FIRST family in the catalog to publish the COMPLETE ladder --
        // rungs 1, 2, 3 and 4 -- and all three registered variants (anima_base, anima_aesthetic,
        // anima_turbo) are real providers sharing one contract builder, one staged `Residency` seam,
        // one tiled VAE decode, one bounded-attention primitive and one block-residency stream. They
        // differ only in the DiT checkpoint file and their default steps/CFG, and each still owes its
        // own per-tier evidence: sharing code is explicitly not what makes an entry Verified.
        //
        // Measured on real anima_base bf16 weights at 1024^2 (Apple/Metal), against the exact
        // untiled/unwindowed reference in `tests/shared_memory_ladder_real_weights.rs`:
        //   * rung 2 (Qwen-Image VAE `decode_tiled`): the isolated decode peak falls 12.927 -> 9.159
        //     GiB at the published edge 640 / overlap 64, request peak 7.921 -> 4.153 GiB, at max
        //     delta 1/255 and mean delta 0.0107. The domain [768, 640, 512, 384, 320, 256, 192] is
        //     the ADMITTED set; 640 is the default because it is the cheapest edge that still holds
        //     max delta 1/255 (768 costs 4.649 GiB for the same quality). Edges 160/128/96 are
        //     measured and REJECTED on drift (0.0706 / 0.1000 / 0.1685 mean).
        //   * rung 3 (`sdpa_budgeted_bhsd` through BOTH DiT attentions): the denoise phase goes
        //     5.378 -> 5.229 GiB (-2.8%) with the output unchanged (max delta 0).
        //   * rung 4 (`block_residency::run_windowed` over the 28 Cosmos DiT blocks): at the
        //     published window 1 the denoise phase goes 5.229 -> 1.110 GiB and the REQUEST peak goes
        //     5.229 -> 4.151 GiB, byte-identical output. Windows 2/4/14/28 are REFUSED (1.497 GiB),
        //     so the cadence domain is genuinely [1] rather than truncated -- window 1 differs from
        //     the next admitted plan by a real 26%.
        //
        // The rung-4 SCOPE is `Dit` only, and that too is a measured decision: rung 1 already sheds
        // the Qwen3-0.6B tower before denoise, and the 6-block `llm_adapter` conditioner is ~1% of
        // the DiT checkpoint, so a `TextEncoder` scope's only honest measured value here is 0.0%.
        // Publishing a scope whose measured value is zero would put a meaningless choice in front of
        // the selector.
        //
        // Rung 4 is declared per LOAD (`streamable` == `LoadShape::DeferredMaterialization`), not
        // per tier, and additionally requires rung 1 ENGAGED in the same request -- without the phase
        // release the conditioner and VAE stay resident alongside the window and the request peak
        // does not move. Both are declared on the contract so the shared selector enforces them.
        //
        // TIER SCOPE CAVEAT: every measured Anima figure above is anima_base bf16. q4/q8 carry the
        // CAPABILITY claim (the rung is per-load, not per-tier) and no measured peak. Anima has no
        // hosted per-tier download variant at all -- the q4/q8/bf16 matrix is packed on-device by the
        // `anima_quant` converter -- which is also why the matrix advertises only the q4 tier here.
        "memoryStrategyContract": {
          "abi": 1,
          "provider": "anima_base",
          "implementations": [
            {
              "rung": "bounded_decode",
              "fingerprint": "anima-mlx-cosmos-shared-ladder-v1",
              "tiers": ["bf16", "q4", "q8"],
              "modes": ["text_to_image"],
              "overlays": ["none", "lora"],
              "engagedRungs": ["resident", "staged_residency", "bounded_decode"],
              "parameters": { "decodeTileEdge": 640, "decodeOverlap": 64 },
              "parameterRanges": { "decodeTileEdges": [768, 640, 512, 384, 320, 256, 192], "decodeOverlaps": [64] },
              "source": "inference:crates/media/mlx-gen/mlx-gen-anima/src/memory_strategy.rs"
            },
            {
              "rung": "bounded_attention",
              "fingerprint": "anima-mlx-cosmos-shared-ladder-v1",
              "tiers": ["bf16", "q4", "q8"],
