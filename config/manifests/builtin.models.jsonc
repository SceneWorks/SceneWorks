        // (`model_supports_img2img` reads `ui.img2img`) — no per-model worker routing. Strength 0.5.
        "img2img": true,
        "img2imgStrength": { "label": "Reference strength", "default": 0.5, "min": 0.0, "max": 1.0, "step": 0.05 },
        "description": "NVIDIA SANA 1600M — an efficient Linear-DiT image model, ported natively to MLX on Apple Silicon and Candle on NVIDIA CUDA (Windows/Linux). Its 1.6B linear-attention transformer, deep-compression 32× DC-AE, and Gemma 2 instruction text encoder support text-to-image plus reference-guided image-to-image with true classifier-free guidance and negative prompts. Runs ~20 steps at guidance 4.5 (flow-match Euler, shift 3.0). Apple Silicon offers pre-packed q4 (default), q8, and bf16 tiers; Candle uses the original dense snapshot. The SANA transformer and VAE are licensed by NVIDIA under Apache-2.0; the bundled Gemma 2 text encoder is governed by Google's Gemma Terms of Use and Prohibited Use Policy.",
        "recommendedFor": ["text_to_image", "image_to_image"],
        "promptGuide": {
          "title": "SANA Prompt Guide",
