        // default — renders cleanly at a fraction of the two-DiT cost. Guidance 7.0 (asymmetric CFG).
        "resolution": "1024x1024",
        "steps": 48,
        "guidanceScale": 7.0,
        "count": 1,
        "sampler": "default",
        "scheduler": "default"
