          "estimatedSizeBytes": 26100000000,
          "footprint": { "diskSizeBytes": 26100000000, "residentMemoryBytes": null, "peakMemoryBytes": null }
        },
        {
          "provider": "huggingface",
          "repo": "SceneWorks/flux2-klein-9b-kv-mlx",
