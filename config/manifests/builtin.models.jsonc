    {
      "id": "flux2_klein_9b_kv",
      "name": "FLUX.2 [klein] 9B-KV",
      "family": "flux2-klein",
      "type": "image",
      "adapter": "mlx_flux2",
      // KV-optimized distill of the same FLUX.2 [klein] 9B family. With a
      // reference image the KV cache caches reference K/V on step 0 and reuses
      // it on steps 1-3 (faster edit; sc-2163, PR filipstrand/mflux#426).
      // Without a reference it runs plain text-to-image on par with the base
      // 9B — the cache simply doesn't engage (sc-2173), so the full
      // capability set is exposed rather than gating to character_image only.
      // No `macOnly` label — dropped with the base 9B entry's (sc-20530); it is inert on an image
      // entry and backend availability comes from the routing and descriptor contracts.
      "capabilities": ["text_to_image", "image_to_image", "edit_image", "character_image"],
      "downloads": [
        {
          // SceneWorks pre-quantized MLX turnkey (sc-8711, epic 8506): public/ungated re-host of
          // black-forest-labs/FLUX.2-klein-9b-kv. Per-tier subdirs q4/ (default), q8/, bf16/ — only
          // the transformer is packed; the Qwen3 TE stays DENSE bf16 in every tier (Quant::None at
          // load via `mlx.denseTextEncoderTier`). Replaces the old gated whole-repo + load-time quantize.
          "provider": "huggingface",
          "repo": "SceneWorks/flux2-klein-9b-kv-mlx",
          "revision": "406265beebe141024a06e24038c3713cf7af87d8",
          "variant": "q4",
          "default": true,
          "files": ["q4/*"],
          "estimatedSizeBytes": 21700000000,
          "footprint": { "diskSizeBytes": 21700000000, "residentMemoryBytes": null, "peakMemoryBytes": null }
        },
        {
          "provider": "huggingface",
          "repo": "SceneWorks/flux2-klein-9b-kv-mlx",
          "revision": "406265beebe141024a06e24038c3713cf7af87d8",
