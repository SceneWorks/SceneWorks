    {
      "id": "flux2_dev",
      // Which generation AXES this engine actually has (sc-15299), the image-lane sibling of the
      // `video` sub-block sc-8445 added for Krea Realtime. FLUX.2 [dev] uses embedded guidance (`uses_embedded_guidance`), so no negative branch.
      // ⚠️ Polarity matches `video` and is the OPPOSITE of `audio`: an ABSENT key means TRUE, so
      // every entry that declares nothing here is byte-identical to its pre-sc-15299 behaviour.
      "image": {
        "supportsSchedulerShift": true,
        "supportsNegativePrompt": false
      },
      "name": "FLUX.2 [dev]",
      "family": "flux2-dev",
      "type": "image",
      // FLUX.2 [dev] (epic 5914) — the guidance-distilled 32B flagship, a SEPARATE
      // model from klein: a Mistral3 text encoder (vs klein's Qwen3) + a 48/48/15360
      // DiT, ported natively to mlx-gen (sc-5915/5916/5917/2365). No torch backend.
      // Shares the `mlx_flux2` adapter + the `flux2` engine. On Apple Silicon it runs
      // on MLX (the pre-quantized Q4 dir below); off-Mac the **candle** (Windows/Linux
      // CUDA) lane now serves txt2img (epic 6564: `candle-gen-flux2` `flux2_dev`, sc-7457
      // provider + sc-7458 worker wiring). sc-20530 REMOVED the `macOnly: true` this entry
      // carried, mirroring klein: on an image entry the flag is inert (only the video
      // catalog-withdrawal contract and the id-pinned web vision captioner read it), and
      // reading like a platform contract this candle-routed entry does not have is the
      // whole cost of keeping it. Candle availability is driven by the routing tables. The
      // candle lane loads the dense diffusers snapshot and Q4-quantizes it at load (the
      // install-time convert + packed loader are MLX-only; off-Mac is download-and-go).
      // Image edit + reference (sc-5919/5922): reference image(s) condition via the
      // DiT token concat through the `flux2_dev_edit` variant — the same surface as
      // klein. Off-Mac the candle lane now serves this too (sc-7736: `Flux2Edit::load_dev`,
      // Q4) alongside the real FLUX.2-dev strict-pose ControlNet (`Flux2Control`,
      // Fun-Controlnet-Union; engine sc-2292 / candle sc-7460). On MLX the pose library is
      // best-effort (skeleton-as-edit-image) below the strict `flux2_dev_control` tier.
      "adapter": "mlx_flux2",
      "capabilities": ["text_to_image", "edit_image", "character_image"],
      "downloads": [
        {
          // SceneWorks pre-quantized MLX turnkey (sc-8513, epic 8506): a public/ungated re-host of
          // black-forest-labs/FLUX.2-dev under the FLUX Non-Commercial License (LICENSE.md travels
          // with the weights — no BFL token or license-click needed). Per-tier subdirs: q4/ (default)
          // and q8/ (opt-in). Replaces the old 112 GB gated dense download + install-time Q4 convert:
          // the worker now loads the chosen tier's packed subdir directly (`flux2_dev_model_subdir`).
          // bf16 tier added separately. q8/ is a second entry (tier selection: epic 8506 sc-8508/8509).
          "provider": "huggingface",
          "repo": "SceneWorks/flux2-dev-mlx",
          "revision": "2868b1461b2b6e6e05d84e52534df3632b4c7d5d",
          "variant": "q4",
          "default": true,
          "files": ["q4/*"],
          "estimatedSizeBytes": 33600000000,
          "footprint": { "diskSizeBytes": 33600000000 }
        },
        {
          "provider": "huggingface",
          "repo": "SceneWorks/flux2-dev-mlx",
          "revision": "2868b1461b2b6e6e05d84e52534df3632b4c7d5d",
          "variant": "q8",
          "files": ["q8/*"],
          "estimatedSizeBytes": 55000000000,
          "footprint": { "diskSizeBytes": 55000000000 }
        },
        {
          // bf16/ — the dense diffusers tree (sharded), the max-fidelity tier for high-memory Macs
          // (192/256/512 GB). Selectable via per-variant tracking (sc-8508/8509). MLX load of the
          // dense sharded tier is on-device-verified (sc-8513: loads all shards via Quant::None +
          // generates; 256² fits a 128 GB box, production 1024² wants >128 GB).
          "provider": "huggingface",
          "repo": "SceneWorks/flux2-dev-mlx",
          "revision": "2868b1461b2b6e6e05d84e52534df3632b4c7d5d",
          "variant": "bf16",
          "files": ["bf16/*"],
          "estimatedSizeBytes": 113000000000,
          "footprint": { "diskSizeBytes": 113000000000 }
        }
      ],
      "defaults": {
        // Guidance-distilled (embedded scalar, NOT true-CFG): ~28 steps (24–50 ok) at
        // guidance 4.0 — the FLUX.1-dev pattern, no negative prompt. (sc-2365.)
        "resolution": "1024x1024",
        "steps": 28,
        "guidanceScale": 4.0,
        "count": 1
      },
      "limits": {
        "resolutions": ["768x768", "1024x1024", "1280x720", "720x1280"],
        "count": [1, 2],
        "samplers": ["default", "euler", "euler_ancestral", "heun", "dpmpp_2m", "dpmpp_sde", "uni_pc", "lcm", "ddim"],
        "schedulers": ["default", "normal", "simple", "karras", "exponential", "sgm_uniform", "beta", "ddim_uniform"]
      },
      // 32B DiT + ~24B Mistral TE. In-app Q4 *load* of the dense bf16 snapshot peaks
      // ~105 GB (> the 128 GB ceiling), so the snapshot is pre-quantized to Q4 ON DISK
      // by the install-time convert job (mlx.requiresConversion + the `flux2_dev_quant`
      // converter, sc-5917): the offline quantize peaks ~34.5 GB. The worker then loads
      // the packed dir (load `.quantize()` is a no-op on already-packed weights). Q4
      // weights floor ~30 GB but generate is activation-bound — 1024²/28 peaks ~74 GB
      // (sc-2365) — so minMemoryGb 96 (128 GB Macs only). The convert pre-quantizes
      // transformer + text_encoder and symlinks the (identical-to-klein) VAE +
      // tokenizer + model_index.json from the gated source snapshot.
      // Worker-layer footprint (Q4, 1024², /usr/bin/time -l peak): T2I ~74 GB, single-reference
      // edit ~81 GB — both within 96. Multi-reference edit (sc-6211): with the engine's
      // sequence-gated activation chunking (sc-6266) a 2-image edit peaks ~81 GB and a 4-image
      // ~93 GB (down from ~104 GB un-chunked, sc-5923) — so the canonical multi-reference edit is
      // now a first-class sub-96 GB mode, reachable via the Image-Studio multi-image picker
      // (ui.multiReference). minMemoryGb stays 96 (inflating it would gate the common 74 GB T2I
      // path behind 128 GB-only). The edit is still activation-bound, so the FLUX.2 provider's
      // calibrated safety contract (re-anchored on the chunked curve) rejects the genuinely
      // over-budget combinations (≥3 references / higher resolution that exceed the machine's
      // unified memory) with an actionable message instead of a silent OOM.
      "mlx": {
        "standardTierLayout": true,

        "quantize": 4
      },
      // Candle/CUDA prompt-enhancement high water re-measured for the v3 caption-upsample lifecycle on
      // RTX PRO 6000 Blackwell (sm_120), with VramProbe on an otherwise idle GPU. Exact merged-source Q8
      // edit evidence is under `.codex/evidence/sc-18474/inference-e1995384...`; Q4 T2I/edit and Q8 T2I
      // evidence is under `.codex/evidence/sc-18474/inference-351a482f...`, whose inference commit is an
      // ancestor of e1995384 and differs from the merge tree only in the MLX FLUX.2 model adapter.
      // All captures use the native Candle route, 256x256, one diffusion step, one caption token, and an
      // exactly-once typed Enhanced report: Q4 T2I 40.8 GB, Q4 edit 42.7 GB, Q8 T2I 70.8 GB, Q8 edit
      // 70.8 GB. These are bounded route high-waters, NOT 1024 calibration records. `vramMeasuredPixels`
      // therefore stays honest at 256², and the old v2 1024 ladder bindings below remain historical only:
      // the live v3 provider fingerprint rejects them before selection. The static rows use the largest
      // observed high-water per tier; the common gate adds its 2 GB reserve, yielding conservative host
      // tiers of 48 GB for Q4 and 80 GB for Q8. No BF16 row is published without fresh evidence.
      "candle": {
        // Historical SC-15833 Q4 base-only CUDA ladder bindings. Keep their exact 5ffd revision,
        // closure digest, v2 fingerprint, and 1024 geometry for auditability; do not restamp them.
        // The live provider reports the v3 caption-upsample fingerprint, and the worker requires an
        // exact calibration-identity match before a packaged record can enter selection. These rows
        // therefore document prior behavior only and cannot authorize a v3 route or a small GPU.

        // END generated-from-engine-capabilities
      },
      "gated": false,
      "licenseUrl": "https://huggingface.co/SceneWorks/flux2-dev-mlx/blob/main/LICENSE.md",
      "ui": {
        "label": "FLUX.2 [dev]",
        "description": "Black Forest Labs FLUX.2 [dev] — the 32B guidance-distilled flagship text-to-image + reference-editing model, running natively through MLX on Apple Silicon and Candle/CUDA on Windows/Linux. A larger, higher-fidelity sibling of FLUX.2 [klein] with a Mistral-3 text encoder and a 48-layer flow transformer; runs ~28 steps at guidance 4.0. Supports reference editing — drop in a source or character image and the model conditions on it (single + multi-image), the same surface as FLUX.2 [klein]. Pre-quantized and hosted by SceneWorks (Q4 ~31 GB default; Q8 available) — downloads ready-to-run with no install-time conversion or gated source download. The MLX configuration needs a 128 GB Mac (~74 GB peak at 1024²; reference editing adds the reference tokens on top, so expect higher peaks and slower renders than klein). Distributed under the FLUX Non-Commercial License (non-commercial use only); SceneWorks hosts a public, ungated re-host, so no Hugging Face token or license acceptance is needed before downloading. LoRAs are coming separately.",
        "recommendedFor": ["text_to_image", "character_image"],
        "pid": { "checkpointId": "pid_flux2" },
        // Embedded-guidance edit knob: maps to the dev guidance scale (default 4.0,
        // 1–10), the same "Prompt strength" surface as the klein edit variants
        // (mlx_flux2 adapter). The reference is concatenated structurally (not a
        // strength blend), so this knob steers prompt adherence, not blend weight.
        "variationStrength": {
          "label": "Prompt strength",
          "default": 4.0,
          "min": 1.0,
          "max": 10.0,
          "step": 0.5
        },
        // Shares the FLUX.2-klein angle set (same mlx_flux2 adapter + flux2 prompt
        // augments): per-angle prompt over a shared seed + the reference image.
        "viewAngles": [
          { "id": "three_quarter_left", "label": "Three-quarter left" },
          { "id": "three_quarter_right", "label": "Three-quarter right" },
          { "id": "left_profile", "label": "Left profile" },
          { "id": "right_profile", "label": "Right profile" },
          { "id": "up", "label": "Looking up" },
          { "id": "down", "label": "Looking down" },
          { "id": "up_left", "label": "Up · left" },
          { "id": "up_right", "label": "Up · right" },
          { "id": "down_left", "label": "Down · left" },
          { "id": "down_right", "label": "Down · right" },
          { "id": "front", "label": "Front" }
        ],
        // Strict pose tier (sc-2292 engine + sc-6055 wiring; candle sc-7460 engine + sc-7736
        // wiring): the worker renders the selected library pose to an OpenPose skeleton and
        // conditions the ported FLUX.2-dev Fun-Controlnet-Union branch on it (true pose lock,
        // one image per pose) — the macOS MLX `flux2_dev_control` registry generator, and
        // off-Mac the candle `Flux2Control` bespoke lane — not the best-effort `MultiReference
        // [skeleton, reference]` edit tier. The control checkpoint
        // (`alibaba-pai/FLUX.2-dev-Fun-Controlnet-Union`, ~8 GB) is fetched on the first pose
        // job (both backends). A pose job with NO reference is pure pose; a reference is an
        // opt-in img2img-init (advanced.referenceStrength, MLX only). Surfaces dev in the
        // Character Studio pose picker (character_image not required — poseLibrary gates it).
        "poseLibrary": true,
        // Strict ControlNet → expose the pose-lock-strength slider (advanced.controlScale;
        // the dev Fun-Controlnet-Union README recommends 0.65–0.80, worker default 0.75).
        "poseControlScale": true,
        // Strict-control modes the FLUX.2-dev Fun-Controlnet-Union branch admits (sc-8248): pose
        // (skeleton), canny (auto edge map from the input image), depth (auto Depth-Anything-V2 map).
        // SINGLE SOURCE OF TRUTH is STRICT_CONTROL_ENGINES (flux2_dev_control = {pose,canny,depth}); the
        // picker offers the control-mode selector (advanced.controlMode).
        "controlModes": ["pose", "canny", "depth"],
        // The control-lock-strength knob (advanced.controlScale; worker default 0.75). Structured form of
        // the `poseControlScale` flag.
        "controlScale": { "label": "Control strength", "default": 0.75, "min": 0.0, "max": 2.0, "step": 0.05 },
        // FLUX.2-dev's built-in caption upsampler (sc-6030/sc-6135): an opt-in "Enhance prompt"
        // toggle that has the model's own Mistral3 LLM rewrite the prompt before the diffusion
        // encode — text-only for txt2img, and image-conditioned on the reference for edit (it reads
        // the reference image, unlike the generic "Refine my prompt" / prompt_refine button). Sets
        // advanced.enhancePrompt; the worker threads it into the dev GenerationRequest (off by
        // default; every other model ignores the field).
        "promptEnhance": true,
        // Multi-image reference editing (sc-6211): Image Studio shows a multi-select reference
        // picker (vs the single-image picker) for the edit/reference flow. The picker sends the
        // plural `referenceAssetIds`; the worker conditions the FLUX.2-dev edit on all of them
        // (Conditioning::MultiReference). The DiT's sequence-gated activation chunking (sc-6266)
        // keeps a 2-reference 1024² edit under 96 GB; the worker memory guard rejects per-machine
        // over-budget combinations. Only FLUX.2-dev exposes this today (the only multi-reference-
        // capable image model with the sub-96 GB chunking).
        "multiReference": true,
        "promptGuide": {
          "title": "FLUX.2 [dev] Prompt Guide",
          "path": "/prompt-guides/flux2-dev.md",
          "sources": [
            { "label": "FLUX.2 [dev] model card", "url": "https://huggingface.co/black-forest-labs/FLUX.2-dev" },
            { "label": "FLUX.2 announcement", "url": "https://bfl.ai/blog/flux-2" }
          ]
        }
      }
