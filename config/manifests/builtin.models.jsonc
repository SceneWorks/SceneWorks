      "resources": {
        "checkpoint": {
          "repo": "Lightricks/LTX-2.3",
          "file": "ltx-2.3-22b-dev.safetensors"
        },
        "distilledCheckpoint": {
          "repo": "Lightricks/LTX-2.3",
          "file": "ltx-2.3-22b-distilled-1.1.safetensors",
          "variants": {
            "1.1": "ltx-2.3-22b-distilled-1.1.safetensors",
            "1.0": "ltx-2.3-22b-distilled.safetensors"
