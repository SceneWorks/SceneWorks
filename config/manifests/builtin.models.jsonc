      "licenseUrl": "https://huggingface.co/Efficient-Large-Model/Sana_Sprint_1.6B_1024px",
      "ui": {
        "label": "SANA-Sprint 1.6B",
        // img2img (sc-10190): same ported DC-AE encoder as base SANA; Sprint seeds the SCM/TrigFlow
        // few-step loop by renoising the encoded init to the strength-derived start angle. Distilled/
        // few-step, so the strength window is narrower than base SANA — validate the band on-device.
        "img2img": true,
        "img2imgStrength": { "label": "Reference strength", "default": 0.5, "min": 0.0, "max": 1.0, "step": 0.05 },
        "description": "NVIDIA SANA-Sprint 1.6B — the few-step SANA distillation, ported natively to MLX on Apple Silicon and Candle on NVIDIA CUDA (Windows/Linux). The same 1.6B linear-attention transformer, 32× DC-AE, and Gemma 2 instruction text encoder as base SANA support text-to-image plus reference-guided image-to-image. Its CFG-free SCM/TrigFlow sampler and guidance-embedding trunk generate a 1024×1024 image in about two steps with no negative prompt. Apple Silicon offers pre-packed q4 (default), q8, and bf16 tiers; Candle uses the original dense snapshot. Distributed under the NVIDIA Open Model License (non-commercial): generations are for non-commercial / research use only. The SceneWorks mirror is un-gated and carries the upstream license + notice.",
        "recommendedFor": ["text_to_image", "image_to_image"],
        "promptGuide": {
          "title": "SANA Prompt Guide",
          "path": "/prompt-guides/sana.md",
          "sources": [
            { "label": "SANA-Sprint model card (NVIDIA)", "url": "https://huggingface.co/Efficient-Large-Model/Sana_Sprint_1.6B_1024px" },
            { "label": "SANA project page", "url": "https://nvlabs.github.io/Sana/" },
            { "label": "SANA-Sprint paper (few-step distillation)", "url": "https://arxiv.org/abs/2503.09641" }
          ]
        }
      }
    },
    {
      "id": "anima_base",
      // Anima 2B (epic 10512 / sc-10523) — CircleStone Labs' anime text-to-image model, ported natively
      // to mlx-gen (engine id `anima_base`). The Cosmos-Predict2 `CosmosTransformer3DModel` DiT (28
      // layers, 17-channel patch-embed, 3-axis NTK RoPE) + the bundled `AnimaTextConditioner` (T5 query
      // tokens cross-attending Qwen3-0.6B states) + the Qwen-Image VAE. Runs on MLX (macOS) AND the candle
      // off-Mac lane (Windows/Linux CUDA): the candle port sc-10525 is now GPU-validated on real CUDA
