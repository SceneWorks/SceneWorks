          // +6.54 GiB resident. The KV cache does NOT change — it holds bf16 activations, so it is
          // 7.14 GiB on every tier. Marked derived, not measured: only Q4 was run on-device.
          "footprint": { "diskSizeBytes": 27290719452, "residentMemoryBytes": 25717886976, "peakMemoryBytes": 36980832256, "measuredPixels": 1048576 }
        },
        {
          "provider": "huggingface",
          "repo": "SceneWorks/krea-realtime-14b-mlx",
          "revision": "e68e9a3d98187fdf6936838ffcf6df5aa48d6626",
          "variant": "bf16",
          // The bf16 DiT is SHARDED one level deeper (`bf16/transformer/dit-0000N-of-00007`),
          // because a single 28.58 GB bf16 file is above the practical single-blob limit the
          // rehost emits; the q4/q8 DiTs are packed small enough to stay flat as `dit.safetensors`.
          // The engine handles either layout (`t2v::open_transformer_weights` takes a flat
          // `dit.safetensors` OR a `transformer/` dir), so this is a hosting shape, not a second
          // load path. All 7 shards are listed individually — see the glob note above.
          "files": [
            "bf16/config.json",
            "bf16/t5_encoder.safetensors",
            "bf16/tokenizer.json",
            "bf16/vae.safetensors",
            "bf16/transformer/dit-00001-of-00007.safetensors",
            "bf16/transformer/dit-00002-of-00007.safetensors",
            "bf16/transformer/dit-00003-of-00007.safetensors",
            "bf16/transformer/dit-00004-of-00007.safetensors",
            "bf16/transformer/dit-00005-of-00007.safetensors",
            "bf16/transformer/dit-00006-of-00007.safetensors",
            "bf16/transformer/dit-00007-of-00007.safetensors"
          ],
          "platforms": ["macos"],
          // 7 DiT shards totalling 28,577,095,227 + the shared dense companions.
          "estimatedSizeBytes": 40463370856,
          // DERIVED the same way: the bf16 DiT is 28,577,095,227 B, i.e. +18.81 GiB over Q4.
          // This tier is what sets `mlx.minMemoryGb` — its ~47 GiB active peak is the largest any
          // installable tier reaches, and a single per-model floor has to admit it.
          "footprint": { "diskSizeBytes": 40463370856, "residentMemoryBytes": 38891536384, "peakMemoryBytes": 50154536960, "measuredPixels": 1048576 }
        }
      ],
      "paths": {
        "model": "${HF_CACHE}/SceneWorks/krea-realtime-14b-mlx"
      },
      "defaults": {
        // 24 fps: the model's own cadence (the card's reference driver exports at
        // `fps=24`), NOT the 16 the rehost's emitted `config.json` inherits from Wan.
        // See the limits note for why 24 is also the only cadence that keeps every
        // advertised duration on the AR block lattice.
        "duration": 4,
        "fps": 24,
        "resolution": "832x480",
        "quality": "balanced",
        // 6 few-step denoises per frame-block — the reference driver's own
        // `num_inference_steps=6`, exposed through the Advanced steps control.
        "steps": 6,
        "sampler": "default",
        "scheduler": "default"
      },
      "limits": {
        // ---- fps + duration lattice (DERIVED, not inherited) --------------------------------
        // Three facts compose into the lattice:
        //   1. The z16 Wan VAE is 4x temporal, so an output frame count must satisfy
        //      `frames = 4k + 1` (core's `wan_frame_count` FLOORS to the largest such value).
        //   2. The AR loop consumes `num_frames_per_block = 3` LATENT frames per block, and a
        //      latent count is `(frames - 1) / 4 + 1`. A whole number of blocks therefore wants
        //      that latent count to be a multiple of 3 — i.e. `frames = 12k - 3`. A partial
        //      trailing block is handled (`generate.rs::chunk_frame_counts`), it is just wasted
        //      work rendering frames the clip then trims.
        //   3. Krea Realtime is a 24 fps model.
        // At 24 fps, `wan_frame_count(24 * d) = 24d - 3 = 12(2d) - 3` for every integer d — so
        // EVERY advertised duration lands on an exact 2d-block boundary: 2s -> 45 frames / 4
        // blocks, 3s -> 69 / 6, 4s -> 93 / 8, 5s -> 117 / 10. At the config's inherited 16 fps
        // it does not: 4s -> 61 frames -> 16 latent frames, which is 5 blocks plus a 1-frame
        // remainder. That is the derivation, and `krea_realtime_durations_are_on_the_ar_block_
        // lattice` (video_request.rs) pins it.
        //
        // `hardMaxDuration` 5 is a stability ceiling, not a memory one: the shipped checkpoint
        // runs `sink_size = 0`, so a bounded-window AR clip drifts as it lengthens (sc-15127
        // tracks the non-zero-sink fix). 5s / 10 blocks is just past the reference driver's own
        // 9-block example.
        "durations": [2, 3, 4, 5],
        "recommendedMaxDuration": 5,
        "hardMaxDuration": 5,
        "fps": [24],
        // ---- geometry -----------------------------------------------------------------------
        // Stride 16 = the z16 Wan 2.1 VAE's 8px spatial stride x the DiT's patch 2, the same
        // lattice the rest of the Wan-14B family renders on. The engine derives its per-frame
        // token count from the REQUESTED size (`t2v::resolve_request_config` recomputes
        // `frame_seq_length` from the latent dims), so the reference's baked 1560 (= 52x30 for
        // 832x480) is a default, not a constraint — every bucket below is genuinely renderable.
        //
        // NO `maxPixels`: unlike the Wan/bernini/scail2 14B engines, mlx-gen-krea-realtime
        // declares no area check — its descriptor bounds each EDGE (`max_size: 1280`) and
        // gen-core's `validate_request` has no area term. A model with no engine cap must not
        // invent one (the `ENGINE_GEOMETRY` contract), so this stays absent rather than
        // borrowing the 14B family's 921,600.
        //
        // 832x480 is the reference bucket and the default. The 720p pair is legal geometry and
        // renders, but it is ~2.3x the tokens per frame and therefore ~2.3x the AR KV cache
        // (~17.7 GB vs ~7.7 GB bf16) — see mlx.minMemoryGb.
        "requiresDimensionsMultipleOf": 16,
        "resolutions": ["832x480", "480x832", "1280x720", "720x1280"],
        // Sealed sampler surface: the engine advertises exactly one sampler, its fixed
        // Self-Forcing few-step renoise schedule (`SELF_FORCING_SAMPLER`), and no scheduler
        // axis at all. There is nothing to choose, so this declares the sealed-adapter
        // `["default"]` (the schema's own convention) rather than inventing a `self_forcing`
        // menu entry the worker would never send — it passes `sampler: None` / `scheduler: None`.
        "samplers": ["default"],
        "schedulers": ["default"]
      },
      "loraCompatibility": {
        // Krea Realtime gets its OWN family token. The DiT is Wan 2.1 T2V 14B weight-for-weight,
        // so Wan-family style/motion LoRAs do install on it (sc-15015 wired the dense
        // forward-time residual path, tier-agnostic over the packed Q4/Q8 bases) — but declaring
        // `wan-video` HERE would make this entry a member of the Wan family for every other
        // family-keyed gate too (training bases, tier layout, repo resolution), which it is not.
        // The one-directional "also accepts wan-video LoRAs" relation belongs in the
        // `extra_compatible_lora_families` registry (sceneworks-core `lora_family.rs`), where it
        // is now declared, and which is the same registry that lets a checkpoint DETECTED as
        // `wan-video` satisfy this declared family (it is, byte-for-byte).
        "families": ["krea-realtime"],
        "types": ["style", "motion", "character", "enhance"]
      },
      "mlx": {
        // Turnkey pre-converted MLX repo (no requiresConversion). The worker resolves env
        // override (SCENEWORKS_MLX_KREA_REALTIME_DIR) -> app-managed <data>/models/mlx/
        // krea_realtime -> this download-on-first-use snapshot, mirroring bernini/scail2.
        //
        // minMemoryGb 64 — a CLOSED DERIVATION as of sc-8446 (S13), measured on-device. It keeps the
        // same value it had as a placeholder, but for a materially different reason.
        //
        // MEASURED (Apple M5 Max, Q4 tier, 832x480 / 81 frames / 24 fps, shipped Self-Forcing
        // schedule). Cumulative MLX **active** peak by phase:
        //     through the first denoise step   9.6 GiB
        //     after the AR denoise loop       17.4 GiB
        //     after the terminal VAE decode   27.9 GiB   <- the whole-run ceiling
        // The AR plateau closes against the components: Q4 DiT ~7.8 + KV 7.14 + VAE ~0.5 = ~15.4 GiB.
        // The KV figure is measured, not modelled: 40 layers x 9360 tokens (a 6-latent-frame window at
        // 1560 tok/frame) x 40 heads x 128 dims x {k,v} x bf16 = 7.14 GiB, flat from chunk 2 on. It
        // holds ACTIVATIONS, so it does not shrink with the weight tier.
        //
        // The transient this comment used to hedge against is now quantified, and it is SMALLER than
        // feared: the VAE decode adds +10.5 GiB over the AR loop, not the ~2x assumed from the scail2
        // case. It also does not grow with clip length (33- and 81-frame clips both peak at 27.6-27.9
        // GiB), because the decode is temporally tiled.
        //
        // So what justifies 64 is the TIER LADDER, not the decode. A single per-model floor must admit
        // the heaviest INSTALLABLE tier, and bf16 swaps a 7.8 GiB DiT for a 26.6 GiB one (exact hosted
        // byte counts) => ~47 GiB active peak. 64 covers that with OS/app headroom. Per tier it would
        // be Q4 ~40 / Q8 ~48 / bf16 64 — the per-download `footprint` blocks now carry those numbers;
        // this single field cannot express them.
        //
        // ⚠️ One caveat plus sc-15325's settled decode result:
        //   * They are MLX **active**. The allocator's reclaimable buffer cache took the same run to
        //     ~90 GiB on a 128 GB host. Active is the right basis for a floor (MLX frees cache under
        //     pressure), but `get_peak_memory` must never be quoted as "the memory this uses".
        //   * sc-15325 (inference PR #292 / 51d65a1a) added spatial tiling to the corrected decode
        //     policy. The decode-phase floor fell from ~20 GiB to ~7.5 GiB (192 px spatial tile,
        //     +0.17/255), so the measured 27.90 / 34.44 / 46.71 GiB ladder is conservative rather
        //     than at risk of a raise.
        //
        // The 720p buckets add ~9.4 GiB of KV (3600 vs 1560 tokens/frame) on top of any tier — that,
        // not the weight tier, is the memory-relevant resolution jump. The UMT5 text encoder (11.4 GB
        // bf16) is NOT additive: loaded, used and freed before the DiT stages, and floored to Q8
        // (~5.7 GB) whenever the DiT tier is quantized, so it never sets the peak on q4/q8.
        "minMemoryGb": 64,
        "repo": "SceneWorks/krea-realtime-14b-mlx",
        // Declares Q4 as this model's default tier, matching the `default: true` q4 download.
        // ⚠️ This key is DOCUMENTATION on a video entry, not the mechanism. `mlx.quantize` is read
        // by the IMAGE lane (`resolve_quant`, image_jobs/base.rs); the video lane never consults it
        // — and deliberately so. sc-10859 made the video lane's Q4-first default an owned carve-out
        // from the app-wide Q8 default (there is no MLX video Q8 lever, so a silent Q8 only risks a
        // video-runtime OOM), and letting a manifest key flip it would quietly undo that. What
        // actually picks the tier is `krea_realtime_tier_order` (`video_jobs/krea_realtime.rs`,
        // sc-15258), which reads `advanced.mlxQuantize` through the shared `resolve_mlx_dense_quant`
        // and independently defaults to `q4`-first, then descends into the installed `<tier>/`
        // subdir. The 4 here therefore AGREES with the resolver rather than driving it; a future
        // edit to this number would NOT move the video lane. (bernini and scail2_14b declare the
        // same thing for the same reason.)
        "quantize": 4,
        "limits": {
          "samplers": ["default"],
          "schedulers": ["default"]
        }
      },
      "ui": {
        "label": "Krea Realtime 14B",
        "description": "Krea Realtime 14B: a Wan 2.1 14B backbone distilled with Self-Forcing into an autoregressive video generator. It renders frame-blocks left-to-right against a rolling causal KV cache at ~6 steps per block, so it produces a finished clip in far fewer total denoises than a whole-clip 14B diffusion. Text-to-video, image-to-video (a reference still warms the cache), and video-to-video (a source clip drives the init). macOS native MLX only; CFG-off, so there is no negative prompt or guidance control.",
        "recommendedFor": ["text_to_video", "video_to_video"],
        "durationHint": "Generates at 24fps on a 3-frame autoregressive block lattice — every duration here lands on a whole number of blocks (2s = 45 frames, 5s = 117). Keep clips at 5s or less: the shipped checkpoint has no attention sink, so longer clips drift.",
        "promptGuide": {
          "title": "Krea Realtime 14B Prompt Guide",
          "path": "/prompt-guides/krea-realtime.md",
          "sources": [
            { "label": "Krea Realtime 14B model card", "url": "https://huggingface.co/krea/krea-realtime-video" },
            { "label": "Krea Realtime technical blog post", "url": "https://www.krea.ai/blog/krea-realtime-14b" },
            { "label": "krea-ai/realtime-video inference code", "url": "https://github.com/krea-ai/realtime-video" }
          ]
        }
      }
    },
