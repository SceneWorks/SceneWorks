      "paths": {
        "model": "${HF_CACHE}/SceneWorks/sdxl-base-mlx"
      },
      "gated": false,
      "defaults": {
        // SDXL base 1.0: EulerDiscreteScheduler default; real CFG with a
        // negative prompt. ~30 steps at guidance 7.0 is a solid baseline.
        "resolution": "1024x1024",
        "steps": 30,
        "guidanceScale": 7.0,
        "count": 4
      },
      "limits": {
        // Native 1024x1024 plus the canonical SDXL aspect-ratio buckets.
        "resolutions": ["1024x1024", "1152x896", "896x1152", "1216x832", "832x1216", "1344x768", "768x1344"],
        "count": [1, 2, 4],
        "samplers": ["default", "euler", "euler_ancestral", "heun", "dpmpp_2m", "dpmpp_sde", "uni_pc", "lcm", "ddim"],
        "schedulers": ["default", "normal", "simple", "karras", "exponential", "sgm_uniform", "beta", "ddim_uniform"]
      },
      "loraCompatibility": {
        // Declare the real family so the picker only offers sdxl-family LoRAs
        // (per sc-1927: an empty families list would match EVERY LoRA). SDXL is
        // the most common community LoRA architecture, so imported sdxl LoRAs
        // become compatible immediately.
        "families": ["sdxl"],
        "types": ["style", "enhance", "character"]
      },
      // macOS-only MLX backend. The MLX-SDXL generator is the Rust `mlx-gen-sdxl`
      // path, claimed by the in-process `mlx` GPU worker via the Rust API claim
      // layer (jobs_store::sdxl_mlx_eligible). sc-3060 RETIRED the old in-process
      // vendored Apple `mlx-examples/stable_diffusion` MLX-SDXL adapter (it lived in
      // the now-deleted Python worker, removed in epic 8283); MLX-SDXL now runs only
      // through the Rust `mlx-gen-sdxl` path above.
      //
      // mlx.quantize/tier config below is consumed by the RUST worker
      // (standard_tier_subdir / resolve_quant), NOT the retired Apple adapter. The
      // original sc-1975 deferral ("Apple's Q8 recipe breaks SDXL base 1.0, works on
      // turbo only") applied to that retired vendored Python recipe. mlx-gen PR #62
      // (sc-2641) FIXED + MERGED SDXL Q4/Q8 quantization — both hold parity on
      // base-1.0 — so the packed tiers below ship Q4 (default) / Q8 / bf16. Q8 base
      // render-verified coherent on-device (768x768, mean 97.65, std 61.43, NOT the
      // retired recipe's all-zero decode).
      //
      // No sampler/scheduler limits override: the MLX SDXL EulerDiscrete schedule
      // already matches the torch path's default. If the picker grows sampler choices
      // later (currently no `limits.samplers` for sdxl), this block will need the same
      // default-only override as the mflux family entries.
      "mlx": {
        "minMemoryGb": 50,
        // q4/ default tier (sc-8746); q8/ + bf16/ hosted + selectable via advanced.mlxQuantize
        // (standard_tier_subdir resolves the subdir).
        "quantize": 4,
        // sc-8508: the manifest-driven form of the STANDARD_TIER_MODELS registry. Additive here
        // opts this id into `uses_standard_tier_layout` so the worker resolves the q4/q8/bf16
        // subdir directly from the turnkey snapshot.
        "standardTierLayout": true,
        // CFG++ (epic 7434, sc-8256) is MLX-only today: the reparameterized-guidance
        // dispatch lives in mlx-gen-sdxl, so only the MLX backend advertises it. The base
        // `limits` carries no guidanceMethods, so the candle lane shows the standard CFG
        // surface (and picks up cfg_pp when sc-8257 lands a candle dispatch + descriptor).
        "limits": {
          "guidanceMethods": ["cfg", "cfg_pp"]
        },
        // SC-15525 (+ SC-16355, SC-17679): pinned export of the shared memory-strategy contract
        // implemented by mlx-gen-sdxl. ONE provider (`engine_id: "sdxl"`) serves FIVE catalog
        // entries — sdxl, realvisxl, realvisxl_lightning, illustrious_xl_v1, illustrious_xl_v2 —
        // so the declaration is repeated per entry with that entry's OWN measured tier coverage.
        // Sharing code is explicitly not what makes a catalog entry Verified.
        //
        // Rung 4 windows each `Transformer2D` sub-stack independently through
        // `mlx_gen::block_residency::run_windowed`. SDXL-base has ELEVEN of them at forward-order
        // depths [2, 2, 10, 10, 10, 10, 10, 10, 2, 2, 2] — six at depth 10 and FIVE at depth 2 —
        // for 70 windowable blocks. (SC-16355's survey text said four 2-deep; the up path carries
        // `layers_per_block + 1 = 3` attentions, so it is five.) `BlockPlan::new` clamps a window to
        // its stack's depth, so a cadence wider than 2 degrades the five 2-deep stacks to fully
        // resident rather than erroring — which is why the domain is stated once, not per depth, and
        // why 10 is the widest cadence that means anything here.
        //
        // The DEFAULT cadence is 10, not 1 (SC-17679). The peak column is FLAT across [1, 2, 5, 10]
        // at every geometry the instrument can resolve, because the peak is taken in the decode
        // rather than in the windowed forward — so cadence cannot move it and the cheap end costs
        // nothing. The two 512² cells that once looked non-flat were allocator noise indexed by
        // execution POSITION, not by cadence, and are withdrawn. Cadence 10 renders 1262 vs cadence
        // 1's 3524 ms/step at 1024².
        //
        // Measured at 1024²/4 steps against each entry's own staged control (byte-identical output):
        // sdxl bf16 19.005 → 14.938 GiB (−21.40%); realvisxl bf16 19.003 → 14.936 (−21.40%);
        // realvisxl q8 17.693 → 15.516 (−12.31%); realvisxl q4 16.654 → 15.493 (−6.97%);
        // realvisxl_lightning q4 16.654 → 15.493 (−6.97%). The saving is the whole
        // `transformer_blocks` weight set (4.071 / 2.166 / 1.149 GiB by tier), so a selector sizing
        // rung 4 off the q8 row under-buys at bf16 by a factor of three.
        //
        // RUNGS 2 AND 3 ARE `Missing` WITH MEASUREMENTS, not unattempted, so they are deliberately
        // absent from `implementations` rather than silently omitted:
        //   * rung 2's tiled decode works and would have bought 19.0032 → 15.8660 GiB (−16.51%) of
        //     request peak for ~7% wall clock (isolated decode 14.360 → 11.237 GiB, −21.7%, at edge
        //     896). It is withheld on QUALITY: the inherited sibling drift bar is 48/255, and on the
        //     PRODUCTION latent the same 1024²/edge-896/overlap-192 geometry drifts 84/255 (the
        //     synthetic-latent sweep read 38 — which is why the withholding had to be measured on
        //     what the denoiser actually hands the decode phase). It fails the bar outright at
        //     1280²/1536²/2048², and `decodeTileEdges` has no geometry axis to vary with output size.
        //   * rung 3 reaches every attention site including the IP-Adapter decoupled branch, but
        //     moves the peak 0.00% at BOTH measured scopes — request 19.0032 → 19.0032 GiB, U-Net
        //     seam 6.5868 → 6.5868 GiB — and is not bit-exact on its query-row axis (max|Δeps|
        //     5.25e-3; 57/255 of image movement at one step, a different image by six). An earlier
        //     revision published the seam as +5.1% from an un-warmed control; warmed, the unbounded
        //     row reads the same 6.5868 the bounded one always did.
        //
        // `overlays` are per tier because `streamable` requires `adapters_are_replayable`, which is
        // true only on an already-packed snapshot: a LoRA load arms rung 4 at q4/q8 and is refused at
        // a dense bf16 base, because the alternative is quietly rendering without the LoRA the user
        // asked for. `identity` is absent: no rung-4 IP-armed row has been measured on this provider.
        //
        // NOTE for whoever records the exact evidence: no `mlx.calibrations` binding can be added for
        // this family's rung 4 until sc-17728 lands. `parse_evidence_parameters` requires
        // decodeTileEdge / decodeOverlap / attentionChunkSize on EVERY rung-4 binding, and this
        // provider has none to name -- rungs 2 and 3 are Missing here, so no selectable strategy sets
        // them. The static contract below is unaffected; it is read by the matrix generator, not by
        // the Rust evidence-binding path.
        "memoryStrategyContract": {
          "abi": 1,
          "provider": "sdxl",
          "implementations": [
            {
              "rung": "bounded_transformer_residency",
              "fingerprint": "sdxl-mlx-unet-shared-ladder-v3",
              "tiers": ["bf16"],
              "modes": ["text_to_image", "style_variations", "edit_image", "image_inpaint", "image_detail", "character_image"],
              "overlays": ["none"],
              "engagedRungs": ["resident", "staged_residency", "bounded_transformer_residency"],
              "parameters": { "transformerWindowSize": 10, "transformerWindowComponent": "Dit" },
              "parameterRanges": { "transformerWindowSizes": [1, 2, 5, 10], "transformerWindowComponents": ["Dit"] },
              "source": "inference:crates/media/mlx-gen/mlx-gen-sdxl/src/memory_strategy.rs"
            }
          ]
        }
      },
      "ui": {
