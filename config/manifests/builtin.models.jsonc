      "admissionGeometry": {
        "maxSide": 2752,
        "maxPresetArea": 4300800,
        "maxTargetImageTokens": 16800,
        "maxReferenceImages": 10,
        "tokensPerMaxReference": 4096,
        "maxJointTokens": 58016,
        "pixelsPerToken": 16,
        "maxBatch": 8
      },
      // ── THE DERIVED MEMORY LADDER — Turbo's OWN derived numbers (E10) ──────────────────────────
      //
      // Same rule as base, applied to Turbo's derivation: floor = ceil(peak GiB x 1.25), the peak
      // being `derived::default_path_peak_max_bytes_for(Variant::Turbo, tier)` on MLX. The ONLY
      // input that differs from base on MLX is the resident VAE (bf16, 0.63 GiB where base's f32
