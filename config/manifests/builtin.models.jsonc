            },
            {
              "rung": "bounded_decode",
              "tiers": ["bf16", "q8", "q4"],
              "modes": ["text_to_image", "edit_image", "image_to_image", "character_image"],
              "overlays": ["none"],
              "loadProfiles": ["plain"],
              "source": "config/engine-capabilities/capabilities.candle.json#memoryContracts/flux2_klein_9b"
