      "paths": {
        "model": "${HF_CACHE}/SceneWorks/kolors-mlx"
      },
      "defaults": {
        // Model card: DPMSolverMultistep (Karras) / Euler; guidance ~5.0, ~25 steps.
        "resolution": "1024x1024",
        "steps": 25,
        "guidanceScale": 5.0,
        "count": 4
      },
      "limits": {
        "resolutions": ["768x768", "1024x1024", "1280x720", "720x1280"],
        "count": [1, 2, 4],
        "samplers": ["default", "euler", "euler_ancestral", "heun", "dpmpp_2m", "dpmpp_sde", "uni_pc", "lcm", "ddim"],
        "schedulers": ["default", "normal", "simple", "karras", "exponential", "sgm_uniform", "beta", "ddim_uniform"]
      },
      "loraCompatibility": {
        // Kolors uses an SDXL-style UNet. Advertise only the kolors family so the
        // picker never offers cross-architecture LoRAs (e.g. z-image): an empty
        // list makes loraMatchesModel treat Kolors as compatible with EVERY LoRA.
        // No kolors-family LoRAs exist yet, so the compatible list stays empty
        // until generation-side Kolors LoRA support lands.
        "families": ["kolors"],
        "types": ["style", "enhance", "character"]
      },
      "mlx": {
        // Standard q4/q8/bf16 turnkey tiers (sc-9946, epic 8506). q4 default; the ChatGLM3-6B TE is
        // packed (not dense) like flux1/sana, so the load-time quant is a harmless no-op on the
        // already-packed weights and bf16 resolves to Quant::None — no `mlx.denseTextEncoderTier` declaration.
        "minMemoryGb": 24,
        "quantize": 4,
        "repo": "SceneWorks/kolors-mlx",
        // SC-15521: pinned export of the shared memory-strategy contract implemented by
        // mlx-gen-kolors. Kolors runs `mlx_gen_sdxl::UNet2DConditionModel` VERBATIM, but it does NOT
        // share SDXL's fingerprint and inherits none of SC-15525's numbers: it conditions on
        // ChatGLM3-6B (3.98 / 6.64 / 11.63 GiB by tier) rather than SDXL's ~0.8B CLIP-L + bigG pair,
        // and that inverts which phase carries the request peak at several advertised geometries.
        //
        // THIS IS THE LADDER'S FIRST GENUINELY THREE-VALUED RUNG-4 SCOPE. Kolors publishes
        // `transformerWindowComponents: [Dit, TextEncoder, Both]` because both trunks are uniform
        // stacks: the U-Net's eleven Transformer2D (70 blocks) and ChatGLM3-6B's 28 GlmBlocks.
        // Measured at bf16/512² against the 11.3644 GiB staged control, the scope choice is
        // load-bearing rather than degenerate: `Dit` 11.3644 GiB (+0.00%), `TextEncoder` 8.8396
        // (−22.22%), `Both` 4.5436 (−60.02%). At the geometry where conditioning carries the peak,
        // bounding the U-Net alone moves nothing at all.
        //
        // Per tier at 1024², rung 4 `Dit` against that tier's own staged control: q4 −7.21%
        // (16.0411 → 14.8840 GiB), q8 −12.72%, bf16 −21.37%. The peak is FLAT across the whole
        // cadence domain [1, 2, 5, 10]; cadence buys wall clock only (3745 → 1507 ms/step at
        // 1024² q4), and the provider's production default stays the tight cadence 1.
        //
        // RUNGS 2 AND 3 ARE `Missing` WITH MEASUREMENTS, not unattempted, so they are deliberately
        // absent from `implementations` rather than silently omitted:
        //   * rung 2 is the family's biggest lever — 16.0412 → 9.9981 GiB (−37.67%) at 1024² q4 for
        //     +10% wall clock — and CLEARS the inherited 48/255 drift bar at 1024² (38) and 1280²
        //     (26), but FAILS it at 1536² (69) and 2048² (53). `decodeTileEdges` is an absolute pixel
        //     domain with no geometry axis, so no fixed edge holds a constant tile fraction across a
        //     2× output range. Unlock tracked as inference sc-17678.
        //   * rung 3 reaches every attention site but moves the peak 0.00% at BOTH measured scopes —
        //     request 16.0412 → 16.0410 GiB, U-Net seam 5.3652 → 5.3652 GiB across three runs — and
        //     is not bit-exact on its query-row axis (max|Δeps| 3.929e-3; 16/255 of image movement at
        //     one step, 212/255 by four). An earlier revision published the seam as +12.54% from an
        //     un-warmed control: MLX's first `run` in a process reads ~4.6-4.8 GiB whichever plan it
        //     executes.
        //
        // `overlays` are per tier because `streamable` requires `adapters_are_replayable`, which is
        // true only on an already-packed snapshot: a LoRA load arms rung 4 at q4/q8 and is refused at
        // the dense bf16 tier (the alternative would be rendering the base model and calling it a
        // LoRA render). `identity` rides both, proven end to end by
        // `the_rung_four_stream_replays_an_installed_ip_adapter`. `control` is absent: the Kolors
        // ControlNet adds a second down-path of 34 TransformerBlocks that the window does not bound,
        // and no rung-4 control row has been measured.
        //
        // NOTE: same sc-17728 constraint as the SDXL family -- an exact `mlx.calibrations` rung-4
        // binding cannot be written for this provider until the evidence-parameter validator stops
        // requiring rung-2/3 parameters on a composition that engages neither.
        "memoryStrategyContract": {
          "abi": 1,
          "provider": "kolors",
          "implementations": [
            {
              "rung": "bounded_transformer_residency",
              "fingerprint": "kolors-mlx-chatglm3-sdxl-unet-ladder-v1",
              "tiers": ["bf16"],
              "modes": ["text_to_image", "edit_image", "character_image", "style_variations"],
              "overlays": ["none", "identity"],
              "engagedRungs": ["resident", "staged_residency", "bounded_transformer_residency"],
              "parameters": { "transformerWindowSize": 1, "transformerWindowComponent": "Dit" },
              "parameterRanges": { "transformerWindowSizes": [1, 2, 5, 10], "transformerWindowComponents": ["Dit", "TextEncoder", "Both"] },
              "source": "inference:crates/media/mlx-gen/mlx-gen-kolors/src/memory_strategy.rs"
            },
            {
              "rung": "bounded_transformer_residency",
              "fingerprint": "kolors-mlx-chatglm3-sdxl-unet-ladder-v1",
              "tiers": ["q4", "q8"],
              "modes": ["text_to_image", "edit_image", "character_image", "style_variations"],
              "overlays": ["none", "lora", "identity"],
              "engagedRungs": ["resident", "staged_residency", "bounded_transformer_residency"],
              "parameters": { "transformerWindowSize": 1, "transformerWindowComponent": "Dit" },
              "parameterRanges": { "transformerWindowSizes": [1, 2, 5, 10], "transformerWindowComponents": ["Dit", "TextEncoder", "Both"] },
              "source": "inference:crates/media/mlx-gen/mlx-gen-kolors/src/memory_strategy.rs"
            }
          ]
        }
      },
      // candle/CUDA VRAM gate (sc-16095): measured on an RTX PRO 6000 Blackwell at 1024².
      // Base peaks were q4 26.681, q8 30.372, and bf16 55.102 GB. The shipping bf16
      // providers raised the family high-water to 63.658 GB for strict control and
      // 61.343 GB for IP-Adapter. These resident providers do not stage phases, so no
      // sequentialPeakGb row is declared. Packed q4/q8 conditioned loading is owned by
      // sc-16171; its matrix cells remain unverified rather than borrowing base evidence.
      "candle": {
        "minMemoryGb": 29,
        "vramGbByTier": { "q4": 26.7, "q8": 30.4, "bf16": 63.7 },
        "vramMeasuredPixels": 1048576,
        "measured": true
      },
      "ui": {
        "label": "Kolors",
        "description": "Kwai-Kolors Kolors — photorealistic text-to-image and image-to-image editing with strong Chinese + English prompting and text rendering (Midjourney-v6-level human eval). Apache-2.0 (commercial-safe). ChatGLM3-6B text encoder + SDXL-style UNet; ~16.5GB checkpoint, real CFG + negative prompt. Recommended ~25 steps at guidance 5.0.",
        "recommendedFor": ["text_to_image", "edit_image", "character_image", "style_variations"],
