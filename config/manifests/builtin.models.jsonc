          // the unrelated single-expert Wan2.1 VACE model. The worker resolves the exact repo from the
          // HF cache and fails closed unless both expert configs are present.
          "provider": "huggingface",
          "repo": "linoyts/Wan2.2-VACE-Fun-14B-diffusers",
          "files": [],
