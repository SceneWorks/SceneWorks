        // methods — CFG-free embedded-scalar guidance). The engines.rs drift guard requires this list to
        // be a SUBSET of the descriptor's honored set, so it must be exactly ["default"].
        "resolutions": ["1024x1024"],
        "count": [1, 2, 4],
        "samplers": ["default"],
        "schedulers": ["default"]
