        // minutes-per-clip (the 7B planner runs up front, then dual-14B denoise) — slow by
        // design, not a bug.
        "minMemoryGb": 64,
        "repo": "SceneWorks/bernini-mlx",
        "quantize": 4,
        "limits": {
