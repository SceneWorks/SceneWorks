+fn apply_worker_memory_limit(gpu_id: &str, bytes: u64, apply: impl FnOnce(u64)) {
+    // CPU utility workers must not initialize the MLX device/allocator at startup.
+    // Every non-CPU worker retains the existing setter and exact configured value.
+    if gpu_id != "cpu" {
+        apply(bytes);
+    }
+}
+
+#[cfg(test)]
+mod cache_cpu_startup_tests {
+    #[test]
+    fn cpu_never_calls_mlx_setter_and_non_cpu_keeps_exact_bytes() {
+        for selector in ["cpu", "mlx", "auto", "0", "GPU-test"] {
+            let mut calls = Vec::new();
+            super::apply_worker_memory_limit(selector, 123, |bytes| calls.push(bytes));
+            assert_eq!(calls, if selector == "cpu" { vec![] } else { vec![123] });
+        }
+    }
+}
