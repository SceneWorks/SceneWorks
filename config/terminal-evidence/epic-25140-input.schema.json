{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "epic-25140-input.schema.json",
  "title": "Epic25140 source-frozen ordinary-product evidence intake",
  "type": "object",
  "required": [
    "schemaVersion",
    "scope",
    "campaignId",
    "projectId",
    "sourceFreeze",
    "artifactInventory",
    "artifacts",
    "turboArtifacts",
    "styles",
    "assets",
    "prompts",
    "bindings",
    "runners",
    "proofRoutes",
    "productProofCases",
    "limits",
    "boundaryBindings",
    "corpusPlan",
    "corpusImportReceipt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scope": {
      "const": "named-required"
    },
    "campaignId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "not": {
        "const": "UNBOUND"
      }
    },
    "sourceFreeze": {
      "type": "object",
      "required": [
        "stage",
        "inferencePin",
        "sceneworks",
        "inference",
        "files",
        "artifactInventorySha256",
        "resourceContract"
      ],
      "properties": {
        "stage": {
          "const": "permanent-inference-main-pin"
        },
        "inferencePin": {
          "$ref": "#/$defs/head"
        },
        "sceneworks": {
          "$ref": "#/$defs/repo"
        },
        "inference": {
          "$ref": "#/$defs/repo"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sha"
          }
        },
        "artifactInventorySha256": {
          "$ref": "#/$defs/sha"
        },
        "resourceContract": {
          "type": "object",
          "required": [
            "mlx",
            "candle_cuda"
          ]
        }
      }
    },
    "artifactInventory": {
      "$ref": "#/$defs/file"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/file"
          },
          {
            "type": "object",
            "required": [
              "id",
              "repo",
              "revision",
              "file",
              "coverage"
            ],
            "properties": {
              "revision": {
                "$ref": "#/$defs/head"
              },
              "coverage": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        ]
      }
    },
    "turboArtifacts": {
      "type": "object",
      "required": [
        "minimax_h3_turbo_4step_768p",
        "minimax_h3_turbo_8step",
        "minimax_h3_turbo_4step_v01",
        "minimax_h3_ref2v_turbo_4step"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/file"
      }
    },
    "styles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/file"
          },
          {
            "type": "object",
            "required": [
              "id",
              "source",
              "licenseEvidence",
              "compatibilityEvidence",
              "models",
              "weight",
              "trigger"
            ],
            "properties": {
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "compatibilityEvidence": {
                "$ref": "#/$defs/file"
              },
              "models": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "minimax_h3",
                    "minimax_h3_ref"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "allOf": [
          {
            "$ref": "#/$defs/file"
          },
          {
            "type": "object",
            "required": [
              "assetId",
              "normalized",
              "type"
            ],
            "properties": {
              "assetId": {
                "type": "string",
                "not": {
                  "const": "UNBOUND"
                }
              },
              "normalized": {
                "$ref": "#/$defs/file"
              },
              "type": {
                "enum": [
                  "image",
                  "video",
                  "audio"
                ]
              }
            }
          }
        ]
      }
    },
    "prompts": {
      "type": "object",
      "required": [
        "t2va",
        "fl2va_first",
        "fl2va_last",
        "fl2va_both",
        "r2va_mixed"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "bindings": {
      "type": "object",
      "required": [
        "t2va",
        "fl2va_first",
        "fl2va_last",
        "fl2va_both",
        "r2va_mixed"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "seed"
        ],
        "properties": {
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "byCanvas": {
            "type": "object",
            "required": [
              "1536x672",
              "672x1536",
              "1344x768",
              "768x1344",
              "1024x768",
              "768x1024",
              "768x768",
              "576x320",
              "320x576"
            ],
            "additionalProperties": {
              "$ref": "#/$defs/carriers"
            }
          }
        }
      }
    },
    "runners": {
      "type": "object",
      "required": [
        "mlx",
        "candle_cuda"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "apiUrl",
          "requestedGpu",
          "workerId",
          "reportedBackend",
          "kernel",
          "physicalGpuId",
          "leasePath",
          "admissionPath",
          "apiBinary",
          "workerBinary",
          "attestation",
          "nativeResources",
          "physicalGuardAdapter"
        ],
        "properties": {
          "nativeResources": {
            "type": "object",
            "required": [
              "schemaVersion",
              "mode",
              "sourceOutput",
              "mlxMetallib"
            ],
            "properties": {
              "schemaVersion": {
                "const": 1
              },
              "mode": {
                "enum": [
                  "locked_cargo_source_build",
                  "not_applicable"
                ]
              },
              "sourceOutput": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "required": [
                      "packageId",
                      "revision",
                      "outDir",
                      "path",
                      "bytes",
                      "sha256"
                    ],
                    "properties": {
                      "packageId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "revision": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{40}$"
                      },
                      "outDir": {
                        "type": "string",
                        "minLength": 1
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  }
                ]
              },
              "mlxMetallib": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/file"
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "locked_cargo_source_build"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "sourceOutput": {
                      "type": "object"
                    },
                    "mlxMetallib": {
                      "$ref": "#/$defs/file"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "not_applicable"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "sourceOutput": {
                      "type": "null"
                    },
                    "mlxMetallib": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          },
          "physicalGuardAdapter": {
            "$ref": "#/$defs/file"
          }
        }
      }
    },
    "proofRoutes": {
      "type": "object",
      "required": [
        "off_identity",
        "exact_frozen_masks",
        "kernel_reference_not_dense",
        "missing_predictor",
        "corrupt_predictor",
        "unsupported_kernel",
        "failed_self_test",
        "independent_budgets",
        "full_layer_step_controls",
        "global_reference_denominator",
        "persistence_replay",
        "managed_digest",
        "bounded_admission_peaks",
        "published_input_boundaries",
        "final_ci_refs_pin_tracker"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "route",
          "requirement"
        ],
        "properties": {
          "route": {
            "enum": [
              "product_job",
              "native_source_contract",
              "integration_receipt"
            ]
          }
        }
      }
    },
    "productProofCases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "carriers": {
            "$ref": "#/$defs/carriers"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "maxJobs",
        "jobTimeoutMs",
        "maxMediaBytes"
      ],
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "corpusPlan": {
      "$ref": "#/$defs/file"
    },
    "corpusImportReceipt": {
      "$ref": "#/$defs/file"
    },
    "boundaryBindings": {
      "type": "object",
      "required": [
        "images_at_cap",
        "clips_at_cap",
        "audio_at_cap_with_visual",
        "combined_at_cap",
        "combined_images_clips_at_cap",
        "combined_images_audio_at_cap",
        "soundtrack_slot_accounting",
        "images_over",
        "clips_over",
        "audio_over",
        "combined_over",
        "audio_only",
        "empty_refs"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/carriers"
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "head": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repo": {
      "type": "object",
      "required": [
        "root",
        "head"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "head": {
          "$ref": "#/$defs/head"
        }
      }
    },
    "carriers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "first": {
          "type": "string",
          "minLength": 1
        },
        "last": {
          "type": "string",
          "minLength": 1
        },
        "images": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "clips": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "audio": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
