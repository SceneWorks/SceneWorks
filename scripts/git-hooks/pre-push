#!/bin/sh
# sc-10463: before pushing Rust changes, run the configurations a macOS `npm run rust:check` CANNOT
# compile, so their cfg/dead-code traps are caught here instead of after a full CI round-trip:
#   * the "neither" build (Linux, no backend-candle)   -> CI's parity lane
#   * the "candle" build (not-macOS + backend-candle)  -> CI's windows-candle lane   (sc-12356)
# The candle lane matters most: it is the ONLY compiler of `cfg(all(not(macos), backend-candle))`,
# and its self-hosted runner can queue for 20+ minutes, so a typo there is expensive to learn about.
# Only runs when the pushed commits touch Rust. Skip with SKIP_NEITHER_CHECK=1 / SKIP_CANDLE_CHECK=1
# or `git push --no-verify`. See CONTRIBUTING.md ("The base.rs / candle cfg rule").
#
# sc-16268: `docs/generated/tier-integrity.*` is derived from Rust routing, the model manifest, and
# its checked-in ledger, so a push touching any input also runs `check:rust-derived-docs`. The memory
# matrix is deliberately absent: its revision records are epic-end measurement provenance, not a
# per-pin freshness gate. The tier check gets its own trigger because a manifest-only push must not
# drag in the two multi-minute Docker builds, which really are Rust-only.
#
# Preflight gate: a push that starts a CI run — to main or codex/**, or to a branch with an open
# PR — must carry a passing `npm run preflight` stamp for the pushed commit (see
# scripts/preflight.mjs). A stamped push skips the neither/candle builds below: preflight ran them.
# Pushing a branch with no PR starts no CI and is not gated.
set -eu

zero="0000000000000000000000000000000000000000"
rust_changed=0
tier_integrity_changed=0
all_stamped=1
unstamped=""

# stdin: "<local ref> <local sha> <remote ref> <remote sha>" per ref being pushed.
while read -r _local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # branch deletion — nothing to lint.

  if node scripts/preflight.mjs --verify "$local_sha" >/dev/null 2>&1; then
    :
  else
    all_stamped=0
    case "$remote_ref" in
      refs/heads/*)
        branch="${remote_ref#refs/heads/}"
        case "$branch" in
          main | codex/*) starts_ci=1 ;;
          *)
            # An unknown answer (gh missing or offline) counts as an open PR.
            open_prs="$(gh pr list --head "$branch" --state open --json number --jq length 2>/dev/null || echo 1)"
            [ "$open_prs" = "0" ] && starts_ci=0 || starts_ci=1
            ;;
        esac
        [ "$starts_ci" = "1" ] && unstamped="$unstamped $branch@$(git rev-parse --short "$local_sha")"
        ;;
    esac
  fi

  if [ "$remote_sha" = "$zero" ]; then
    # New remote branch: diff from the parent of the oldest not-yet-pushed commit.
    oldest="$(git rev-list "$local_sha" --not --remotes 2>/dev/null | tail -n 1)"
    if [ -n "$oldest" ]; then
      base="$(git rev-parse "$oldest^" 2>/dev/null || git hash-object -t tree /dev/null)"
      diff_range="$base..$local_sha"
    else
      diff_range="$local_sha"
    fi
  else
    diff_range="$remote_sha..$local_sha"
  fi

  changed="$(git diff --name-only "$diff_range" 2>/dev/null || true)"

  if printf '%s\n' "$changed" \
    | grep -Eq '(^|/)([^/]+\.rs|Cargo\.(toml|lock)|rustfmt\.toml)$|^\.cargo/.*\.toml$'; then
    rust_changed=1
    tier_integrity_changed=1
  fi

  # The non-Rust inputs and outputs of the tier-integrity audit. Memory-matrix inputs do not belong
  # here: pin bumps and ordinary code changes must never demand an epic-end measurement restamp.
  if printf '%s\n' "$changed" | grep -Eq \
    '^(config/manifests/builtin\.models\.jsonc|config/tier-integrity\.jsonc|packages/schemas/tier-integrity\.schema\.json|scripts/(check-tier-integrity|tier-integrity-measurement-receipts)\.mjs|scripts/lib/jsonc\.mjs|docs/generated/tier-integrity\.(json|md))$'; then
    tier_integrity_changed=1
  fi
done

if [ -n "$unstamped" ]; then
  echo "Push blocked: these pushes start CI but have no passing preflight:$unstamped"
  echo "Commit everything, then run:"
  echo "  npm run preflight -- --base <PR target, e.g. origin/feature/sc-NNNN or origin/main>"
  echo "(bypass with 'git push --no-verify' only for a push that must not wait, e.g. a CI-only fix)"
  exit 1
fi

[ "$all_stamped" = "1" ] && exit 0

# Git exports GIT_DIR (and friends) into hooks. Inherited by cargo, they misdirect dependency build
# scripts that shell out to git from inside cargo's own checkouts, so drop them now that the hook's
# own git calls are done; anything below rediscovers this repo from the cwd.
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)

[ "$rust_changed" = "0" ] && [ "$tier_integrity_changed" = "0" ] && exit 0

if ! command -v npm >/dev/null 2>&1; then
  echo "npm is required to run the pre-push Rust checks. Install Node/npm or add it to PATH."
  exit 1
fi

if ! npm run --silent check:rust-derived-docs; then
  echo
  echo "The generated tier-integrity audit is stale. Regenerate and commit it:"
  echo "  npm run generate:tier-integrity"
  exit 1
fi

[ "$rust_changed" = "0" ] && exit 0

# On macOS the neither build runs in a Linux Docker container; the dev Mac does not run containers,
# so CI's parity lane owns it there.
if [ "$(uname -s)" != "Darwin" ] && [ "${SKIP_NEITHER_CHECK:-0}" != "1" ]; then
  echo "Running the 'neither' build (Linux, no backend-candle) for pushed Rust changes..."
  echo "(skip with SKIP_NEITHER_CHECK=1 or 'git push --no-verify')"

  if ! npm run --silent rust:check:neither; then
    echo
    echo "The neither build failed: an item used only by base.rs / candle-only code is dead on the"
    echo "Linux no-candle build. Gate it with the same cfg as base.rs:"
    echo '  #[cfg(any(target_os = "macos", all(not(target_os = "macos"), feature = "backend-candle")))]'
    echo "See CONTRIBUTING.md ('The base.rs / candle cfg rule')."
    exit 1
  fi
fi

if [ "${SKIP_CANDLE_CHECK:-0}" != "1" ]; then
  echo "Running the 'candle' build (not-macOS + backend-candle) for pushed Rust changes..."
  echo "(skip with SKIP_CANDLE_CHECK=1 or 'git push --no-verify')"

  # --allow-skip: a missing cross target / CUDA toolkit means "cannot check here", not "broken" —
  # it must never block a push from a dev who has not opted into the toolchain.
  if ! npm run --silent rust:check:candle -- --allow-skip; then
    echo
    echo "The candle build failed: this is the ONLY lane that compiles"
    echo '  #[cfg(all(not(target_os = "macos"), feature = "backend-candle"))]'
    echo "so a macOS 'npm run rust:check' cannot see it. Common causes: a pub(crate) symbol defined"
    echo "under a narrower cfg than its candle-only caller (E0425), or an item that is dead once the"
    echo "macOS half is excluded. See CONTRIBUTING.md ('The candle build')."
    exit 1
  fi
fi
