{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneworks.local/schemas/checkpoint-import.schema.json",
  "title": "SceneWorks checkpoint import contracts v1",
  "description": "Backend-neutral discovery, locator, and atomically stored import-plan contracts. Every v1 document rejects unknown schemaVersion values; callers must recompile/rescan rather than best-effort decode.",
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nonBlankText": { "type": "string", "pattern": "(?=.*[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])" },
    "relativePath": { "type": "string", "pattern": "^(?=[\\s\\S]*[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])(?!/)(?![\\s\\S]*\\\\)(?![\\s\\S]*:)(?![\\s\\S]*//)(?![\\s\\S]*(?:^|/)\\.{1,2}(?:/|$))(?![\\s\\S]*(?:^|/)\\.{1,2}$)(?![\\s\\S]*\\/$)[^\\x00-\\x1F\\x7F]+$" },
    "provenance": {
      "type": "object",
      "required": ["source"],
      "dependentRequired": { "importJobId": ["importCommitment"], "importCommitment": ["importJobId"] },
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/nonBlankText" },
        "reference": { "oneOf": [{ "$ref": "#/$defs/nonBlankText" }, { "type": "null" }] },
        "url": { "oneOf": [{ "$ref": "#/$defs/nonBlankText" }, { "type": "null" }] },
        "versionId": { "oneOf": [{ "$ref": "#/$defs/nonBlankText" }, { "type": "null" }] },
        "fileId": { "oneOf": [{ "$ref": "#/$defs/nonBlankText" }, { "type": "null" }] },
        "credentialHost": { "oneOf": [{ "$ref": "#/$defs/nonBlankText" }, { "type": "null" }] },
        "importJobId": { "$ref": "#/$defs/nonBlankText" },
        "importCommitment": { "$ref": "#/$defs/identity" }
      }
    },
    "componentDownload": {
      "type": "object", "required": ["repo", "revision", "files"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "componentClosure": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["download", "revision", "files"],
        "properties": {
          "download": { "$ref": "#/$defs/componentDownload" },
          "revision": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
          "files": { "type": "array", "minItems": 1, "items": {
            "type": "object", "required": ["relativePath", "sha256", "sizeBytes"],
            "properties": {
              "relativePath": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "sizeBytes": { "type": "integer", "minimum": 0 }
            }
          } }
        }
      }
    },
    "modelDeclaration": {
      "type": "object", "required": ["schemaVersion", "baseLineage", "declaredSemantics", "inheritedLicenseAcknowledgments"],
      "properties": {
        "schemaVersion": { "enum": [1, 2] },
        "baseLineage": { "type": "object" }, "declaredSemantics": { "type": "object" },
        "inheritedLicenseAcknowledgments": { "type": "array", "items": { "type": "object" } },
        "componentDownloads": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/componentDownload" } },
        "componentClosure": { "$ref": "#/$defs/componentClosure" }
      },
      "allOf": [{ "if": { "properties": { "schemaVersion": { "const": 2 } } }, "then": { "required": ["componentDownloads", "componentClosure"] } }]
    },
    "sourceLocator": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "schemaVersion", "rootId", "relativePath", "fingerprint"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "linked" }, "schemaVersion": { "const": 1 },
            "rootId": { "$ref": "#/$defs/nonBlankText" },
            "relativePath": { "$ref": "#/$defs/relativePath" },
            "fingerprint": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "schemaVersion", "installId", "relativePath", "sha256", "provenance"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "managed" }, "schemaVersion": { "const": 1 },
            "installId": { "$ref": "#/$defs/nonBlankText" },
            "relativePath": { "$ref": "#/$defs/relativePath" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "provenance": { "$ref": "#/$defs/provenance" }
          }
        }
      ]
    },
    "layer": {
      "type": "object", "required": ["layerId", "role", "targetPath", "container", "source"], "additionalProperties": false,
      "properties": {
        "layerId": { "$ref": "#/$defs/nonBlankText" }, "role": { "$ref": "#/$defs/nonBlankText" },
        "targetPath": { "$ref": "#/$defs/relativePath" },
        "container": { "enum": ["safetensors", "gguf", "json_descriptor"] },
        "source": { "$ref": "#/$defs/sourceLocator" }
      }
    },
    "importPlan": {
      "type": "object", "required": ["schemaVersion", "planId", "family", "layers"], "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 }, "planId": { "$ref": "#/$defs/nonBlankText" },
        "family": { "$ref": "#/$defs/nonBlankText" }, "layers": { "type": "array", "minItems": 1, "maxItems": 4294967295, "uniqueItems": true, "items": { "$ref": "#/$defs/layer" } },
        "context": {
          "type": "object", "description": "Immutable loader configuration and provenance; included in semantic and source-binding identity. Omitted when empty.",
          "properties": { "modelDeclaration": { "$ref": "#/$defs/modelDeclaration" } }
        }
      }
    },
    "planReference": {
      "type": "object", "required": ["schemaVersion", "planId", "semanticDigest", "sourceBindingIdentity"], "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 }, "planId": { "$ref": "#/$defs/nonBlankText" },
        "semanticDigest": { "$ref": "#/$defs/identity" }, "sourceBindingIdentity": { "$ref": "#/$defs/identity" }
      }
    },
    "planSummary": {
      "type": "object", "required": ["schemaVersion", "family", "layerCount", "layerRoles", "semanticDigest"], "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 }, "family": { "$ref": "#/$defs/nonBlankText" },
        "layerCount": { "type": "integer", "minimum": 1, "maximum": 4294967295 }, "layerRoles": { "type": "array", "minItems": 1, "maxItems": 4294967295, "items": { "$ref": "#/$defs/nonBlankText" } },
        "semanticDigest": { "$ref": "#/$defs/identity" }
      }
    },
    "catalogRecord": {
      "type": "object", "required": ["schemaVersion", "checkpointId", "plan", "summary"], "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "checkpointId": { "$ref": "#/$defs/nonBlankText" },
        "plan": { "$ref": "#/$defs/planReference" }, "summary": { "$ref": "#/$defs/planSummary" }
      }
    },
    "checkpointInventory": {
      "type": "object", "required": ["schemaVersion", "records"], "additionalProperties": false,
      "properties": { "schemaVersion": { "const": 1 }, "records": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/catalogRecord" } } },
      "$comment": "Deserialize with CheckpointInventoryV1 after structural validation. It rejects duplicate checkpointId values, mismatched plan/summary semanticDigest values, and any other cross-field invariant that portable JSON Schema cannot express."
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/checkpointInventory" },
    { "$ref": "#/$defs/sourceLocator" },
    { "$ref": "#/$defs/importPlan" },
    { "$ref": "#/$defs/planReference" },
    { "$ref": "#/$defs/planSummary" },
    { "$ref": "#/$defs/catalogRecord" }
  ]
}
