{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneworks.ai/schemas/memory-matrix.schema.json",
  "title": "SceneWorks memory-ladder matrix",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sourceEvidence": {
      "type": "object",
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "engagedRungs": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "resident",
          "staged_residency",
          "bounded_decode",
          "bounded_attention",
          "bounded_transformer_residency"
        ]
      }
    },
    "declaredEvidence": {
      "type": "object",
      "required": [
        "source",
        "tier"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "parityEvidence": {
      "type": "object",
      "required": [
        "contract",
        "result",
        "metric",
        "maximumError",
        "fixture"
      ],
      "additionalProperties": false,
      "properties": {
        "contract": {
          "enum": [
            "exact",
            "tolerance",
            "golden"
          ]
        },
        "result": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "maximumError": {
          "type": "number",
          "minimum": 0
        },
        "fixture": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "historicalEvidence": {
      "type": "object",
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "hardware": {
          "type": "string",
          "minLength": 1
        },
        "evidenceScope": {
          "enum": [
            "exact_request",
            "phase_fit_only"
          ]
        },
        "runtimeAdmission": {
          "type": "boolean"
        },
        "tier": {
          "type": "string",
          "minLength": 1
        },
        "geometry": {
          "type": "string",
          "pattern": "^[1-9][0-9]*x[1-9][0-9]*$"
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "harnessVersion": {
          "type": "string",
          "minLength": 1
        },
        "recordStatus": {
          "enum": [
            "complete",
            "runtime_complete",
            "gated",
            "negative_complete"
          ]
        },
        "engagedRungs": {
          "$ref": "#/$defs/engagedRungs"
        },
        "observedPeakGb": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "requiredHostBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Exact MLX host requirement: max(predicted peak, observed non-reclaimable wired peak) plus the captured foreign unified-memory reserve."
        },
        "parity": {
          "$ref": "#/$defs/parityEvidence"
        }
      },
      "allOf": [
        {
          "if": { "required": ["evidenceScope"] },
          "then": { "required": ["runtimeAdmission"] }
        },
        {
          "if": { "required": ["runtimeAdmission"] },
          "then": { "required": ["evidenceScope"] }
        },
        {
          "if": {
            "properties": { "evidenceScope": { "const": "exact_request" } },
            "required": ["evidenceScope"]
          },
          "then": {
            "properties": { "runtimeAdmission": { "const": true } },
            "required": ["runtimeAdmission", "parity"]
          }
        },
        {
          "if": {
            "properties": { "evidenceScope": { "const": "phase_fit_only" } },
            "required": ["evidenceScope"]
          },
          "then": {
            "properties": { "runtimeAdmission": { "const": false } },
            "required": ["runtimeAdmission"],
            "not": { "required": ["parity"] }
          }
        }
      ]
    },
    "loadabilityEvidence": {
      "type": "object",
      "required": [
        "repository",
        "revision",
        "variant"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "variant": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "strategyEvidence": {
      "type": "object",
      "required": [
        "source",
        "tier",
        "geometry",
        "predictedPeakGb",
        "exactParameters"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "type": "string",
          "minLength": 1
        },
        "geometry": {
          "type": "string",
          "pattern": "^[1-9][0-9]*x[1-9][0-9]*$"
        },
        "predictedPeakGb": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "engagedRungs": {
          "$ref": "#/$defs/engagedRungs"
        },
        "exactParameters": {
          "type": "object"
        }
      }
    },
    "structuralEvidence": {
      "type": "object",
      "required": [
        "source",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rung4StructuralApplicability": {
      "description": "How much of the family's transformer trunk `gen_core::block_window` can bound. `partial` is the value the five-state conformance vocabulary cannot express.",
      "enum": [
        "full",
        "partial",
        "none",
        "requires-different-primitive"
      ]
    },
    "rung4Implementation": {
      "enum": [
        "shared-primitive",
        "provider-local",
        "none"
      ]
    },
    "rung4RequestPeak": {
      "description": "Whether bounding the trunk was MEASURED to move the request peak. Separate from applicability on purpose: a strategy that bounds a phase without moving the request peak is not a saving.",
      "enum": [
        "moves",
        "does-not-move",
        "unmeasured"
      ]
    },
    "rung4Summary": {
      "type": "string",
      "minLength": 1
    },
    "rung4BlockStacks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "blocks",
          "windowable"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "blocks": {
            "type": "string",
            "minLength": 1
          },
          "windowable": {
            "type": "boolean"
          },
          "entries": {
            "description": "Present when the stack exists on only some of the family's catalog entries, so a per-entry difference stays machine-readable instead of being rounded into the family verdict. Every id is checked to belong to the owning family at generation time.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "rung4Findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rung4SurveyVerdict": {
      "description": "SC-15969 per-family rung-4 applicability, as it rides ONE cell. `structuralApplicability` and `requestPeak` are two SEPARATE findings by design: a family can be structurally capable and still correctly default to not using the rung, because a strategy that bounds a phase without moving the request peak is not a saving. `partial` is the value the five-state conformance vocabulary cannot express \u2014 a trunk that is not one uniform stack. `overlayIncompatible` is deliberately NOT folded into `structuralApplicability`: it is a property of the provider's adapter mechanism, so a family whose stack is perfectly windowable would otherwise publish `none` on its overlay cells. sc-18099 moved the family-level `summary`/`blockStacks`/`findings` to `rung4SurveyRows`, where they are carried once per (family, backend) and survive the elision of every one of that family's cells.",
      "type": "object",
      "required": [
        "story",
        "structuralApplicability",
        "requestPeak",
        "implementation",
        "overlayIncompatible"
      ],
      "additionalProperties": false,
      "properties": {
        "story": {
          "const": 15969
        },
        "structuralApplicability": {
          "$ref": "#/$defs/rung4StructuralApplicability"
        },
        "requestPeak": {
          "$ref": "#/$defs/rung4RequestPeak"
        },
        "implementation": {
          "$ref": "#/$defs/rung4Implementation"
        },
        "overlayIncompatible": {
          "description": "True when THIS cell is exempt because the provider's adapter mechanism cannot carry an overlay onto a rebuilt block. Scoped to cells whose entry and mode actually have the streaming path: on a route with no such path the rung is Missing for the ordinary reason, so a sibling cell of the same provider can read `false` while the provider-level fact still holds.",
          "type": "boolean"
        }
      }
    },
    "resolvedAxes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tiers",
        "modes",
        "overlays",
        "rungs"
      ],
      "properties": {
        "tiers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "overlays": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "none",
              "lora",
              "control",
              "identity"
            ]
          }
        },
        "rungs": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "resident",
              "staged_residency",
              "bounded_decode",
              "bounded_attention",
              "bounded_transformer_residency"
            ]
          }
        }
      }
    },
    "backendScopedStories": {
      "description": "Owning Shortcut story per advertised backend (SC-15812). An mlx-only entry carries only `mlx`; a Candle cell can never be covered by the MLX story.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "mlx": {
          "type": "integer"
        },
        "candle": {
          "type": "integer"
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "generatedFrom",
    "conformanceStates",
    "evidenceDimensions",
    "summary",
    "models",
    "rung4SurveyRows",
    "coverage",
    "cells",
    "calibrationRuns",
    "modelSlices",
    "claims",
    "memoryCharacterizationStates"
  ],
  "properties": {
    "schemaVersion": {
      "description": "2 (SC-15812): backend-scoped story ownership. 3 (sc-16268): removed per-cell evidenceRevision. 4 (SC-15969): added rung-4 survey rows. 5 (SC-16060): split implementation and memory-characterization claims. 6 (SC-15823): adds Runtime verified so base-only runtime activation cannot masquerade as Full Verified, and publishes complete/runtime-complete calibration counts. 7 (sc-18099): `cells` is the planned-or-evidenced SUBSET of the catalog cross-product rather than the cross-product itself; `coverage` added and required; `summary` gained publishedCells/elidedCells/elidedByState/publicationPredicate; `modelSlices` entries may be empty; `calibrationRuns[].record` is a projection of the evidence-bundle row.",
      "const": 7
    },
    "generatedFrom": {
      "type": "object"
    },
    "conformanceStates": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "state",
          "definition"
        ],
        "additionalProperties": false,
        "properties": {
          "state": {
            "enum": [
              "Verified",
              "Runtime verified",
              "Implemented/unverified",
              "Structurally N/A",
              "Missing",
              "Route unavailable/broken"
            ]
          },
          "definition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidenceDimensions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "imageModels",
        "cells",
        "publishedCells",
        "elidedCells",
        "elidedByState",
        "publicationPredicate",
        "mlxStagedStaticCoverage",
        "mlxStagedStaticCoverageDenominator",
        "fullModels",
        "calibrationRunsByStatus",
        "rung4Survey"
      ],
      "properties": {
        "cells": {
          "description": "sc-18099: the number of coordinates the CATALOG resolved to, which is NOT `cells.length` any more. `publishedCells` + `elidedCells` partition it.",
          "type": "integer",
          "minimum": 1
        },
        "publishedCells": {
          "type": "integer",
          "minimum": 1
        },
        "elidedCells": {
          "description": "Coordinates resolved but not written, because nothing planned, measured, bound or cited them. Named rather than silently capped: their states are counted in `elidedByState` and their per-lane population in `coverage`.",
          "type": "integer",
          "minimum": 0
        },
        "elidedByState": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "publicationPredicate": {
          "description": "The exact rule that decided publication, so a reader can tell what an absent coordinate means. Generated from scripts/generate-memory-matrix.mjs#PUBLICATION_PREDICATE.",
          "type": "string",
          "minLength": 1
        },
        "calibrationRunsByStatus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["complete", "runtimeComplete"],
          "properties": {
            "complete": { "type": "integer", "minimum": 0 },
            "runtimeComplete": { "type": "integer", "minimum": 0 }
          }
        },
        "rung4Survey": {
          "type": "object",
          "required": [
            "story",
            "surveyedFamilyBackends",
            "structuralApplicability",
            "requestPeak",
            "implementation"
          ],
          "properties": {
            "story": {
              "const": 15969
            },
            "surveyedFamilyBackends": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "rung4SurveyRows": {
      "description": "One row per surveyed (family story, backend). Derived from the generated cells, not re-read from the survey file, so a verdict that never reached a cell cannot appear here as though it had.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "familyStory",
          "backend",
          "structuralApplicability",
          "requestPeak",
          "implementation",
          "summary",
          "blockStacks",
          "findings"
        ],
        "additionalProperties": false,
        "properties": {
          "familyStory": {
            "type": "integer"
          },
          "summary": {
            "$ref": "#/$defs/rung4Summary"
          },
          "blockStacks": {
            "$ref": "#/$defs/rung4BlockStacks"
          },
          "findings": {
            "$ref": "#/$defs/rung4Findings"
          },
          "backend": {
            "enum": [
              "mlx",
              "candle"
            ]
          },
          "structuralApplicability": {
            "$ref": "#/$defs/rung4StructuralApplicability"
          },
          "requestPeak": {
            "$ref": "#/$defs/rung4RequestPeak"
          },
          "implementation": {
            "$ref": "#/$defs/rung4Implementation"
          }
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 53,
      "maxItems": 53,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "family",
          "resolvedRoute",
          "routeKind",
          "backends",
          "owningFamilyStories",
          "owningModelStories",
          "axes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "family": {
            "type": [
              "string",
              "null"
            ]
          },
          "resolvedRoute": {
            "type": "string"
          },
          "routeKind": {
            "enum": [
              "registry",
              "bespoke"
            ]
          },
          "backends": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "mlx",
                "candle"
              ]
            },
            "uniqueItems": true
          },
          "owningFamilyStories": {
            "$ref": "#/$defs/backendScopedStories"
          },
          "owningModelStories": {
            "$ref": "#/$defs/backendScopedStories"
          },
          "axes": {
            "description": "sc-18099. The coordinate axes this entry resolves on each advertised backend. These ARE the cross-product `cells` used to enumerate, published so that eliding an unmeasured coordinate can never make a lane invisible — the sc-16069 failure, where a shipping control lane with no measurement block produced zero cells and absent evidence read as absent feature. Reconciled against the resolved cross-product by validateMatrix before either artifact is written.",
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "mlx": {
                "$ref": "#/$defs/resolvedAxes"
              },
              "candle": {
                "$ref": "#/$defs/resolvedAxes"
              }
            }
          }
        }
      }
    },
    "coverage": {
      "description": "sc-18099. One row per (catalog entry, backend, rung), derived from EVERY resolved coordinate — published or elided. This is the census the cross-product used to be: a consumer that counted `cells` by state reads `states` here and gets the same numbers, including for lanes the slim published nothing from. Its totals are reconciled against the resolved coordinate count and the published cell count by assertPublishedDocumentIsClosed before either artifact is written.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "modelId",
          "backend",
          "rung",
          "coordinates",
          "published",
          "elided",
          "implemented",
          "states"
        ],
        "properties": {
          "modelId": {
            "type": "string",
            "minLength": 1
          },
          "backend": {
            "enum": [
              "mlx",
              "candle"
            ]
          },
          "rung": {
            "enum": [
              "resident",
              "staged_residency",
              "bounded_decode",
              "bounded_attention",
              "bounded_transformer_residency"
            ]
          },
          "coordinates": {
            "type": "integer",
            "minimum": 1
          },
          "published": {
            "type": "integer",
            "minimum": 0
          },
          "elided": {
            "type": "integer",
            "minimum": 0
          },
          "implemented": {
            "description": "Coordinates whose state passes scripts/generate-memory-matrix.mjs#isImplemented, counted over the whole lane rather than over the published subset.",
            "type": "integer",
            "minimum": 0
          },
          "states": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "integer",
              "minimum": 1
            },
            "propertyNames": {
              "enum": [
                "Verified",
                "Runtime verified",
                "Implemented/unverified",
                "Structurally N/A",
                "Missing",
                "Route unavailable/broken"
              ]
            }
          }
        }
      }
    },
    "cells": {
      "description": "sc-18099: the planned-or-evidenced SUBSET of the catalog cross-product, not the cross-product. `summary.publicationPredicate` states the rule that decided membership and `summary.elidedCells` counts what it dropped. No useful minItems exists any more — the population is a function of what has been planned and measured, so any floor here would either be vacuous or would fail the day a lane is descoped. Completeness of the underlying cross-product is still enforced before publication by assertCellInventoryMatchesCatalog, and closure of what was written by assertPublishedDocumentIsClosed, both in scripts/generate-memory-matrix.mjs.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "modelId",
          "resolvedRoute",
          "provider",
          "backend",
          "tier",
          "mode",
          "overlay",
          "rung",
          "geometryEnvelope",
          "strategyParameters",
          "engagedRungs",
          "state",
          "calibrationFingerprint",
          "owningFamilyStory",
          "owningModelStory",
          "evidence",
          "memoryCharacterization"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "modelId": {
            "type": "string"
          },
          "resolvedRoute": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "backend": {
            "enum": [
              "mlx",
              "candle"
            ]
          },
          "tier": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "overlay": {
            "type": "string"
          },
          "rung": {
            "enum": [
              "resident",
              "staged_residency",
              "bounded_decode",
              "bounded_attention",
              "bounded_transformer_residency"
            ]
          },
          "geometryEnvelope": {
            "type": "object"
          },
          "strategyParameters": {
            "type": "object"
          },
          "engagedRungs": {
            "$ref": "#/$defs/engagedRungs"
          },
          "state": {
            "enum": [
              "Verified",
              "Runtime verified",
              "Implemented/unverified",
              "Structurally N/A",
              "Missing",
              "Route unavailable/broken"
            ]
          },
          "calibrationFingerprint": {
            "type": [
              "string",
              "null"
            ]
          },
          "owningFamilyStory": {
            "type": "integer"
          },
          "owningModelStory": {
            "type": "integer"
          },
          "rung4Survey": {
            "$ref": "#/$defs/rung4SurveyVerdict"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "staticImplementation",
              "declaredCalibration",
              "historicalVerification",
              "currentEnvironmentVerification",
              "loadability",
              "strategyParameterVerification",
              "structural"
            ],
            "properties": {
              "staticImplementation": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/sourceEvidence"
                }
              },
              "declaredCalibration": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/declaredEvidence"
                }
              },
              "historicalVerification": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/historicalEvidence"
                }
              },
              "currentEnvironmentVerification": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/historicalEvidence"
                }
              },
              "loadability": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/loadabilityEvidence"
                }
              },
              "strategyParameterVerification": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/strategyEvidence"
                }
              },
              "structural": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/structuralEvidence"
                }
              }
            }
          },
          "memoryCharacterization": {
            "type": "object",
            "required": [
              "status",
              "measuredGeometries",
              "coveredPixelBound"
            ],
            "additionalProperties": false,
            "description": "SC-16060. The geometry-sensitive claim, kept separate from `state` so that one measured geometry cannot read as certifying a whole envelope. `coveredPixelBound` is null unless `status` is `fitted`.",
            "properties": {
              "status": {
                "enum": [
                  "unmeasured",
                  "point",
                  "fitted"
                ]
              },
              "measuredGeometries": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*x[1-9][0-9]*$"
                }
              },
              "coveredPixelBound": {
                "type": [
                  "integer",
                  "null"
                ],
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "allOf": [
          {
            "description": "SC-15969: the survey verdict rides exactly the rung-4 cells. Required there so a cell cannot escape the survey; forbidden elsewhere so the field cannot drift onto another rung and be read as one.",
            "if": {
              "required": [
                "rung"
              ],
              "properties": {
                "rung": {
                  "const": "bounded_transformer_residency"
                }
              }
            },
            "then": {
              "required": [
                "rung4Survey"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "rung4Survey"
                ]
              }
            }
          }
        ]
      }
    },
    "calibrationRuns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cellId",
          "binding",
          "semantics",
          "record"
        ],
        "properties": {
          "cellId": {
            "type": "string",
            "minLength": 1
          },
          "binding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "eligible",
              "reasons"
            ],
            "properties": {
              "eligible": {
                "type": "boolean"
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "semantics": {
            "enum": [
              "current",
              "historical",
              "gated",
              "negative",
              "fixture"
            ]
          },
          "record": {
            "description": "sc-18099: a PROJECTION of the evidence-bundle row, not the row. The full record ships and is schema-validated in docs/generated/memory-calibration-evidence.json; embedding all 65 verbatim cost 436 KB of duplication. `id` is the join key and `source` spells the join out. Kept here is exactly what the matrix itself asserts about a record: which coordinate it targets, what composition it exercised, how it dates, and which fingerprint it carries.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "backend",
              "target",
              "strategy",
              "calibrationFingerprint",
              "capturedAt",
              "harnessVersion",
              "repositories",
              "source"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "complete",
                  "runtime_complete",
                  "gated",
                  "negative_complete"
                ]
              },
              "backend": {
                "enum": [
                  "mlx",
                  "candle"
                ]
              },
              "target": {
                "type": "object"
              },
              "strategy": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "rung",
                  "engagedRungs"
                ],
                "properties": {
                  "rung": {
                    "enum": [
                      "resident",
                      "staged_residency",
                      "bounded_decode",
                      "bounded_attention",
                      "bounded_transformer_residency"
                    ]
                  },
                  "engagedRungs": {
                    "$ref": "#/$defs/engagedRungs"
                  }
                }
              },
              "calibrationFingerprint": {
                "type": "string",
                "minLength": 1
              },
              "capturedAt": {
                "type": "string",
                "format": "date-time"
              },
              "harnessVersion": {
                "type": "string",
                "minLength": 1
              },
              "repositories": {
                "type": "object"
              },
              "source": {
                "type": "string",
                "pattern": "^docs/generated/memory-calibration-evidence\\.json#"
              }
            }
          }
        }
      }
    },
    "modelSlices": {
      "description": "Published cell ids per catalog entry. sc-18099 dropped the former 5-item floor: an entry with nothing planned, measured, bound or cited publishes NO cells, and an empty slice is the honest answer. Its lane totals remain in `coverage`.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "claims": {
      "type": "object",
      "required": [
        "state",
        "memoryCharacterization"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "object",
          "required": [
            "asserts",
            "geometrySensitive",
            "binding"
          ],
          "additionalProperties": false,
          "properties": {
            "asserts": {
              "type": "string",
              "minLength": 1
            },
            "geometrySensitive": {
              "type": "boolean"
            },
            "binding": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "memoryCharacterization": {
          "type": "object",
          "required": [
            "asserts",
            "geometrySensitive",
            "binding"
          ],
          "additionalProperties": false,
          "properties": {
            "asserts": {
              "type": "string",
              "minLength": 1
            },
            "geometrySensitive": {
              "type": "boolean"
            },
            "binding": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "memoryCharacterizationStates": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "status",
          "definition"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "unmeasured",
              "point",
              "fitted"
            ]
          },
          "definition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
