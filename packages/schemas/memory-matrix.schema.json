{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneworks.dev/schemas/memory-matrix.schema.json",
  "title": "Generated memory-ladder matrix",
  "description": "The collapsed memory matrix (sc-22513, epic 22505 E5). A cell's `state` is a PURE FUNCTION of three facts published on the cell itself: `implementation` (does the code implement this rung on this route), `anchor` (does `config/memory-anchors.json` hold a measured anchor for this model x tier x backend lane) and `derivationDefined` (is the analytic derivation wired for this lane). Per-geometry characterization, calibration-record joins, plan grids, campaign machinery and currency fingerprints beyond the anchor's own loader-closure digest are GONE from this document; the retained corpora they read are validation data for the derivation, never gates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedFrom",
    "claims",
    "conformanceStates",
    "evidenceDimensions",
    "summary",
    "models",
    "anchors",
    "coverage",
    "cells",
    "modelSlices"
  ],
  "$defs": {
    "sourceRevision": {
      "type": "string",
      "pattern": "^source-tree:[0-9a-f]{64}$"
    },
    "sourceStamp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "backend": { "enum": ["mlx", "candle"] },
    "modality": { "enum": ["image", "video"] },
    "rung": {
      "enum": [
        "resident",
        "staged_residency",
        "bounded_decode",
        "bounded_attention",
        "bounded_transformer_residency"
      ]
    },
    "implementation": { "enum": ["implemented", "structurally-na", "missing"] },
    "state": {
      "description": "The collapsed vocabulary. `Verified`, `Runtime verified` and `Implemented/unverified` were REMOVED by sc-22513 — nothing emits them, and a document carrying one is not a document of this shape.",
      "enum": ["Anchored", "Anchored/underived", "Implemented", "Structurally N/A", "Missing"]
    },
    "evidenceRow": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source"],
      "properties": { "source": { "type": "string", "minLength": 1 } }
    },
    "currencyAttestation": {
      "description": "HOW an anchor's currency key was derived (sc-22667). null: at the record's own measurement revision. Otherwise the reviewed attestation from config/anchor-currency-attestations.json, copied into the store by anchor-loader-closure.mjs --stamp-anchors: the loader-closure diff from `measuredRevision` to `attestedRevision` was read file by file and is accounting-only, or a re-measure on the same hardware witnessed the behaviour unchanged. Bounded to the one revision it names.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["measuredRevision", "attestedRevision", "attestedAt", "story", "class", "why", "witness"],
      "properties": {
        "measuredRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "attestedRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "attestedAt": { "type": "string", "minLength": 1 },
        "story": { "type": "string", "minLength": 1 },
        "class": { "enum": ["accounting-only", "witnessed-unchanged"] },
        "why": { "type": "string", "minLength": 1 },
        "witness": { "type": "string", "minLength": 1 }
      }
    },
    "cellAnchor": {
      "description": "The measured anchor covering this cell's (model, tier, backend lane), or null. `current` is the loader-closure currency term (sc-22511): REPORTED, never gated, and it may not move `state`. `currencyAttestation` says HOW the key behind `current` was derived (sc-22667). `derivable` is the anchor-level derivability term (epic 22505 feature-end fix round, E5): whether the lane's law accepts THIS anchor, read off the store's own `underivedReason` field; false publishes the cell as Anchored/underived, with the stated reason carried in `underivedReason`.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "tier", "source", "current", "currencyAttestation", "derivable"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tier": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "current": { "type": "boolean" },
        "currencyAttestation": { "$ref": "#/$defs/currencyAttestation" },
        "derivable": { "type": "boolean" },
        "underivedReason": { "type": "string", "minLength": 1 }
      }
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tiers", "modes", "overlays", "rungs"],
      "properties": {
        "tiers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "modes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "overlays": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "rungs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rung" } }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    }
  },
  "properties": {
    "schemaVersion": { "const": 11 },
    "generatedFrom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sceneWorksRevision", "sources"],
      "description": "The source-tree fingerprint and the exact set it covers. sc-22513 removed `inferenceRevision`: the inference pin cannot move a cell in this document, and a source that cannot move a cell must not rotate its revision.",
      "properties": {
        "sceneWorksRevision": { "$ref": "#/$defs/sourceRevision" },
        "sources": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/sourceStamp" }
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["asserts", "geometrySensitive", "binding"],
          "properties": {
            "asserts": { "type": "string", "minLength": 1 },
            "geometrySensitive": { "const": false },
            "binding": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "conformanceStates": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "definition"],
        "properties": {
          "state": { "$ref": "#/$defs/state" },
          "definition": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidenceDimensions": {
      "type": "array",
      "items": { "enum": ["staticImplementation", "structural", "anchor"] },
      "minItems": 3,
      "uniqueItems": true
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogEntries",
        "catalogEntriesByModality",
        "cells",
        "publishedCells",
        "elidedCells",
        "elidedByState",
        "publicationPredicate",
        "mlxStagedStaticCoverage",
        "mlxStagedStaticCoverageDenominator",
        "videoMlxStagedStaticCoverage",
        "videoMlxStagedStaticCoverageDenominator",
        "unroutedEntries",
        "outOfMatrixEntries",
        "anchors",
        "analyticOnlyCells",
        "anchoredCells",
        "staleAnchors",
        "attestedAnchors",
        "fullModels"
      ],
      "properties": {
        "catalogEntries": { "type": "integer", "minimum": 1 },
        "catalogEntriesByModality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image", "video"],
          "properties": {
            "image": { "type": "integer", "minimum": 0 },
            "video": { "type": "integer", "minimum": 0 }
          }
        },
        "cells": { "type": "integer", "minimum": 1 },
        "publishedCells": { "type": "integer", "minimum": 0 },
        "elidedCells": { "type": "integer", "minimum": 0 },
        "elidedByState": { "$ref": "#/$defs/counts" },
        "publicationPredicate": { "type": "string", "minLength": 1 },
        "mlxStagedStaticCoverage": { "type": "integer", "minimum": 0 },
        "mlxStagedStaticCoverageDenominator": { "type": "integer", "minimum": 1 },
        "videoMlxStagedStaticCoverage": { "type": "integer", "minimum": 0 },
        "videoMlxStagedStaticCoverageDenominator": { "type": "integer", "minimum": 1 },
        "unroutedEntries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "reason"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "outOfMatrixEntries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "epic", "reason"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "epic": { "type": "integer", "minimum": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "anchors": { "type": "integer", "minimum": 0 },
        "analyticOnlyCells": { "type": "integer", "minimum": 0 },
        "anchoredCells": { "type": "integer", "minimum": 0 },
        "staleAnchors": { "type": "integer", "minimum": 0 },
        "attestedAnchors": { "type": "integer", "minimum": 0 },
        "fullModels": { "type": "integer", "minimum": 0 }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "modality",
          "familyGroup",
          "family",
          "resolvedRoute",
          "resolvedRoutes",
          "routeKind",
          "backends",
          "owningFamilyStories",
          "owningModelStories",
          "axes"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "modality": { "$ref": "#/$defs/modality" },
          "familyGroup": { "type": ["integer", "string"] },
          "family": { "type": ["string", "null"] },
          "resolvedRoute": { "type": "string", "minLength": 1 },
          "resolvedRoutes": {
            "type": "object",
            "additionalProperties": { "type": "string", "minLength": 1 }
          },
          "routeKind": { "type": "string", "minLength": 1 },
          "backends": { "type": "array", "items": { "$ref": "#/$defs/backend" } },
          "owningFamilyStories": {
            "type": "object",
            "additionalProperties": { "type": ["integer", "string"] }
          },
          "owningModelStories": {
            "type": "object",
            "additionalProperties": { "type": ["integer", "null"] }
          },
          "axes": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/axes" }
          }
        }
      }
    },
    "anchors": {
      "description": "The measured anchor inventory (sc-22507/sc-22513). One row per anchor the matrix can cite, with the coordinate it was measured at and how many published cells it covers. This is what replaces `calibrationRuns`: the store IS the evidence join now.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "modelId",
          "backend",
          "tier",
          "provider",
          "mode",
          "geometry",
          "source",
          "current",
          "currencyAttestation",
          "cells"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "modelId": { "type": "string", "minLength": 1 },
          "backend": { "$ref": "#/$defs/backend" },
          "tier": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "minLength": 1 },
          "geometry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["width", "height", "frames"],
            "properties": {
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "frames": { "type": "integer", "minimum": 1 },
              "fps": { "type": ["number", "null"] }
            }
          },
          "source": { "type": "string", "minLength": 1 },
          "current": { "type": "boolean" },
          "currencyAttestation": { "$ref": "#/$defs/currencyAttestation" },
          "cells": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "coverage": {
      "description": "The per-(entry, backend, rung) census over the FULL resolved cross-product, published or not.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "modelId",
          "backend",
          "rung",
          "coordinates",
          "published",
          "elided",
          "implemented",
          "states"
        ],
        "properties": {
          "modelId": { "type": "string", "minLength": 1 },
          "backend": { "$ref": "#/$defs/backend" },
          "rung": { "$ref": "#/$defs/rung" },
          "coordinates": { "type": "integer", "minimum": 1 },
          "published": { "type": "integer", "minimum": 0 },
          "elided": { "type": "integer", "minimum": 0 },
          "implemented": { "type": "integer", "minimum": 0 },
          "states": { "$ref": "#/$defs/counts" },
          "implementedBy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tier", "mode", "overlay"],
            "properties": {
              "tier": { "$ref": "#/$defs/counts" },
              "mode": { "$ref": "#/$defs/counts" },
              "overlay": { "$ref": "#/$defs/counts" }
            }
          }
        }
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "modelId",
          "resolvedRoute",
          "provider",
          "backend",
          "tier",
          "mode",
          "overlay",
          "rung",
          "geometryEnvelope",
          "strategyParameters",
          "implementation",
          "anchor",
          "derivationDefined",
          "state",
          "owningFamilyStory",
          "owningModelStory",
          "evidence"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "modelId": { "type": "string", "minLength": 1 },
          "resolvedRoute": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "backend": { "$ref": "#/$defs/backend" },
          "tier": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "minLength": 1 },
          "overlay": { "type": "string", "minLength": 1 },
          "rung": { "$ref": "#/$defs/rung" },
          "geometryEnvelope": { "type": "object" },
          "strategyParameters": { "type": "object" },
          "implementation": { "$ref": "#/$defs/implementation" },
          "anchor": { "$ref": "#/$defs/cellAnchor" },
          "derivationDefined": { "type": "boolean" },
          "state": { "$ref": "#/$defs/state" },
          "owningFamilyStory": { "type": ["integer", "string"] },
          "owningModelStory": { "type": ["integer", "null"] },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["staticImplementation", "structural", "anchor"],
            "properties": {
              "staticImplementation": {
                "type": "array",
                "items": { "$ref": "#/$defs/evidenceRow" }
              },
              "structural": { "type": "array", "items": { "$ref": "#/$defs/evidenceRow" } },
              "anchor": { "type": "array", "items": { "$ref": "#/$defs/evidenceRow" } }
            }
          }
        }
      }
    },
    "modelSlices": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      }
    }
  }
}
