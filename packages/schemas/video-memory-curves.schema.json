{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneworks.ai/schemas/video-memory-curves.schema.json",
  "title": "SceneWorks fitted video-memory curves",
  "description": "Backend-neutral, lane-tagged and closure-bound per-phase residual-bounded affine cross curves. Runtime consumers must still enforce the complete identity, source handshake, and measured geometry hull.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedBy",
    "sourceFit",
    "sourceCatalog",
    "curves"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "generatedBy": { "const": "scripts/fit-ltx-temporal-form.mjs" },
    "sourceFit": {
      "type": "string",
      "pattern": "^docs/generated/ltx-temporal-form-fit-sc-[0-9]+\\.json$"
    },
    "sourceCatalog": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sourceCatalogEntry" }
    },
    "curves": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/curve" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceCatalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "curve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "modelId",
        "modelFamily",
        "provider",
        "backend",
        "tier",
        "mode",
        "rung",
        "loadShape",
        "batch",
        "closureDigest",
        "calibrationAbi",
        "calibrationFingerprint",
        "decodePass",
        "measuredGeometryHull",
        "phases",
        "evidence"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "modelId": { "type": "string", "minLength": 1 },
        "modelFamily": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "backend": { "enum": ["mlx", "candle"] },
        "tier": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "minLength": 1 },
        "rung": {
          "enum": [
            "resident",
            "staged_residency",
            "bounded_decode",
            "bounded_attention",
            "bounded_transformer_residency"
          ]
        },
        "loadShape": {
          "enum": ["eager_materialization", "deferred_materialization"]
        },
        "batch": { "type": "integer", "minimum": 1 },
        "closureDigest": { "$ref": "#/$defs/sha256" },
        "calibrationAbi": { "const": 3 },
        "calibrationFingerprint": { "type": "string", "minLength": 1 },
        "decodePass": { "enum": ["single_pass", "tiled", "unmodelled"] },
        "measuredGeometryHull": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/hullPoint" }
        },
        "phases": { "$ref": "#/$defs/phases" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "hullPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pixels", "voxels"],
      "properties": {
        "pixels": { "type": "integer", "minimum": 1 },
        "voxels": { "type": "integer", "minimum": 1 }
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conditioning", "denoise", "decode"],
      "properties": {
        "conditioning": { "$ref": "#/$defs/affineCrossCurve" },
        "denoise": { "$ref": "#/$defs/affineCrossCurve" },
        "decode": { "$ref": "#/$defs/affineCrossCurve" }
      }
    },
    "affineCrossCurve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixedGb", "perMpxGb", "perMpxFrameGb", "maxResidualGb"],
      "properties": {
        "fixedGb": { "type": "number", "minimum": 0 },
        "perMpxGb": { "type": "number", "minimum": 0 },
        "perMpxFrameGb": { "type": "number", "minimum": 0 },
        "maxResidualGb": { "type": "number", "minimum": 0 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "records",
        "fitPoints",
        "heldOutPoints",
        "sources"
      ],
      "properties": {
        "records": { "type": "integer", "minimum": 1 },
        "fitPoints": { "type": "integer", "minimum": 1 },
        "heldOutPoints": { "type": "integer", "minimum": 1 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceSource" }
        }
      }
    },
    "evidenceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "recordIds"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "recordIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^imc-[0-9a-f]{20}$" }
        }
      }
    }
  }
}
